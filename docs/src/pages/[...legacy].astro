---
import { routeRedirects } from "../../scripts/route-redirects.mjs";
export function getStaticPaths() {
  return Object.entries(routeRedirects).map(([source, destination]) => ({
    params: { legacy: source.replace(/^\/|\/$/g, "") },
    props: { target: destination },
  }));
}
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}${Astro.props.target}`;
const french = Astro.props.target.startsWith("/fr/");
---
<!doctype html>
<html lang={french ? "fr" : "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>{french ? "Page déplacée — Outpost" : "Page moved — Outpost"}</title>
  </head>
  <body data-pagefind-ignore>
    <main>
      <h1>{french ? "Cette page a été déplacée" : "This page has moved"}</h1>
      <p><a href={target}>{french ? "Ouvrir la page" : "Open the page"}</a></p>
    </main>
    <script is:inline define:vars={{ target, french }}>
      const destination = new URL(target, window.location.origin);
      destination.search = window.location.search;
      destination.hash = window.location.hash;
      if (french && target.endsWith("/chat-history/") && destination.hash === "#continuation-choices") {
        destination.hash = "#choix-de-continuation";
      }
      window.location.replace(destination.href);
    </script>
  </body>
</html>
