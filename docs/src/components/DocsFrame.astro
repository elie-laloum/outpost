---
import Landing from "./landing/Landing.astro";
import Announcement from "./Announcement.astro";
import { docsSpace } from "./docs-route.ts";

const route = Astro.locals.starlightRoute;
const space = docsSpace(route);
---

<div
  class:list={["docs-frame", { "landing-frame": space === "landing", "has-rail": Boolean(route.toc) }]}
  data-space={space}
>
  <header class="docs-top">
    <Announcement />
    <div class="docs-toolbar"><slot name="header" /></div>
  </header>
  <nav class="docs-sidebar" aria-label={Astro.locals.t("sidebarNav.accessibleLabel")}>
    <div id="starlight__sidebar"><slot name="sidebar" /></div>
  </nav>
  {space === "landing" ? <Landing /> : <div class="docs-main main-frame"><slot /></div>}
</div>

<style>
  :global(:root) {
    --docs-toolbar-height: 4rem;
    --docs-announcement-height: 2.5rem;
    --sl-nav-height: calc(var(--docs-toolbar-height) + var(--docs-announcement-height));
  }
  .docs-frame {
    --sl-sidebar-width: 17rem;
    --docs-content-width: 84rem;
    --docs-right-rail-width: 16rem;
    --docs-landing-width: 90rem;
    --docs-content-start: max(
      var(--sl-sidebar-width),
      calc((100% + var(--sl-sidebar-width) - var(--docs-content-width)) / 2)
    );
    --docs-line: var(--sl-color-hairline-light);
    --docs-code-bg: color-mix(in oklch, var(--sl-color-gray-6) 45%, var(--sl-color-black));
    --docs-pad: clamp(1.25rem, 2.6vw, 2.5rem);
    --docs-ease: cubic-bezier(0.16, 1, 0.3, 1);
    min-height: 100vh;
    background: var(--sl-color-black);
  }
  .docs-top {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--sl-z-index-navbar);
    height: var(--sl-nav-height);
    border-bottom: 1px solid var(--docs-line);
    background: var(--sl-color-black);
  }
  .docs-toolbar {
    height: var(--docs-toolbar-height);
  }
  .docs-sidebar {
    position: fixed;
    inset: var(--sl-nav-height) auto 0 0;
    z-index: var(--sl-z-index-menu);
    width: 17rem;
    overflow-y: auto;
    border-right: 1px solid var(--docs-line);
    background: var(--sl-color-black);
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-5) transparent;
  }
  .landing-frame .docs-sidebar {
    display: none;
  }
  .landing-frame {
    --docs-content-start: max(
      var(--sl-sidebar-width),
      calc((100% - var(--docs-landing-width)) / 2)
    );
  }
  .docs-main {
    padding: var(--sl-nav-height) 0 0 17rem;
  }
  .docs-main :global(main) {
    padding: 0;
  }
  .docs-main :global(.content-panel) {
    padding: 0;
    border: 0;
  }
  .docs-main :global(.content-panel .sl-container) {
    max-width: none;
    margin: 0;
  }
  .docs-frame :global(::selection) {
    background: color-mix(in oklch, var(--sl-color-accent) 32%, transparent);
    color: var(--sl-color-white);
  }
  .docs-frame :global(:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  @media (min-width: 100rem) {
    .docs-frame.has-rail:not(.landing-frame) {
      --docs-content-start: max(
        var(--sl-sidebar-width),
        calc((100% + var(--sl-sidebar-width) - var(--docs-content-width) - var(--docs-right-rail-width)) / 2)
      );
    }
  }
  @media (max-width: 49.99rem) {
    :global(:root) {
      --docs-announcement-height: 3.5rem;
    }
    .docs-sidebar {
      display: none;
      width: 100%;
      border-right: 0;
    }
    :global(body[data-mobile-menu-expanded]) .docs-sidebar {
      display: block;
    }
    .docs-main {
      padding-left: 0;
    }
  }
  @media print {
    .docs-top,
    .docs-sidebar {
      display: none;
    }
    .docs-main {
      padding: 0;
    }
  }
</style>
