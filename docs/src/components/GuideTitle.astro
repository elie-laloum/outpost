---
import ExistingTitle from "@astrojs/starlight/components/PageTitle.astro";
import { chapters } from "../../scripts/navigation.mjs";
const entry = Astro.locals.starlightRoute.entry;
const guide = /^(fr\/)?guide\//.test(entry.id);
const french = entry.id.startsWith("fr/");
const chapter = chapters.find(([, , pages]) => pages.includes(entry.id.replace(/^fr\//, "")));
---
{guide ? (
  <div class="guide-title">
    {chapter && <p class="guide-eyebrow">{chapter[french ? 1 : 0]}</p>}
    <h1 id="_top">{entry.data.title}</h1>
    <p class="guide-description">{entry.data.description}</p>
  </div>
) : <ExistingTitle />}
<style>
  .guide-eyebrow { margin: 0 0 .7rem; color: var(--sl-color-gray-3); font-size: .78rem; }
  h1 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.3rem); line-height: 1.2; letter-spacing: -.04em; font-weight: 650; }
  .guide-description { margin: .85rem 0 1rem; color: var(--sl-color-gray-2); font-size: 1rem; line-height: 1.65; }
</style>
