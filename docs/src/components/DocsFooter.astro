---
import EditLink from "virtual:starlight/components/EditLink";

const { pagination } = Astro.locals.starlightRoute;
const cells = [
  { rel: "prev", link: pagination.prev, label: Astro.locals.t("page.previousLink") },
  { rel: "next", link: pagination.next, label: Astro.locals.t("page.nextLink") },
] as const;
---

<footer class="docs-footer">
  {
    (pagination.prev || pagination.next) && (
      <nav class="pager" aria-label={Astro.locals.t("page.previousLink") + " / " + Astro.locals.t("page.nextLink")}>
        {cells.map((cell) =>
          cell.link ? (
            <a class={cell.rel} href={cell.link.href} rel={cell.rel}>
              <span class="pager-label">{cell.label}</span>
              <span class="pager-title">{cell.link.label}</span>
            </a>
          ) : null,
        )}
      </nav>
    )
  }
  <div class="edit"><EditLink /></div>
</footer>

<style>
  .docs-footer {
    margin-top: 0;
  }
  .pager {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    border-bottom: 1px solid var(--docs-line);
  }
  .pager > * {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    min-height: 6rem;
    justify-content: center;
    padding: 1.25rem var(--docs-pad);
    text-decoration: none;
  }
  .pager > * + * {
    border-left: 1px solid var(--docs-line);
  }
  .pager .next {
    align-items: flex-end;
    text-align: end;
  }
  .pager a {
    transition: background-color 0.2s var(--docs-ease);
  }
  .pager a:hover {
    background: var(--docs-code-bg);
  }
  .pager-label {
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .pager-title {
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .edit {
    padding: 1.25rem var(--docs-pad) 2.5rem;
    font-size: 0.8125rem;
  }
  .edit :global(a) {
    color: var(--sl-color-gray-3);
  }
  .edit :global(a:hover) {
    color: var(--sl-color-white);
  }
</style>
