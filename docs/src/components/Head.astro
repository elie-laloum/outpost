---
import StarlightHead from "@astrojs/starlight/components/Head.astro";
import manifest from "../../../package.json";

const route = Astro.locals.starlightRoute;
const home = Boolean(route.entry.data.landing);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const locale = route.locale === "fr" ? "fr" : "en";
const homeUrl = new URL(`${base}/${locale === "fr" ? "fr/" : ""}`, Astro.site)
  .href;
const imageUrl = new URL(`${base}/social/home-${locale}.png`, Astro.site).href;
const description = route.entry.data.description;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeUrl}#website`,
      name: "Outpost",
      url: homeUrl,
      description,
      inLanguage: locale,
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${homeUrl}#software`,
      name: "Outpost",
      url: homeUrl,
      description,
      programmingLanguage: "TypeScript",
      runtimePlatform: "Node.js 24+",
      version: manifest.version,
      license: "https://opensource.org/license/mit/",
      codeRepository: "https://gitlab.elielaloum.com/elielaloum/outpost",
      author: { "@type": "Person", name: "Elie Laloum" },
    },
  ],
};
---
<StarlightHead />
{home && <>
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={route.entry.data.landing!.headline.join(" ")} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:title" content={route.entry.data.title} />
  <meta name="twitter:description" content={description} />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")} />
</>}
<script>
  import { mountCanvases } from "./guide-canvas.ts";
  import { mountCodeTabs } from "./guide-code-tabs.ts";

  const prepareCopyButtons = () => {
    for (const button of document.querySelectorAll<HTMLElement>("celestia-code-copy-button")) {
      button.setAttribute("role", "button");
      button.tabIndex = 0;
      button.setAttribute("aria-label", document.documentElement.lang === "fr" ? "Copier le code" : "Copy code");
    }
  };
  const prepareReferenceStatus = () => {
    const label = document.documentElement.lang === "fr" ? "Expérimental" : "Experimental";
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-api-status="experimental"]')) {
      link.title = label;
      link.setAttribute("aria-label", `${link.textContent?.trim()} — ${label}`);
    }
  };
  // Pin a section's code only when it fits the viewport and its prose is taller.
  const pinSectionCode = () => {
    const wide = window.matchMedia("(min-width: 64rem)").matches;
    for (const pin of document.querySelectorAll<HTMLElement>('.bay:not([data-role="log"]) .bay-pin')) {
      const say = pin.closest(".bay")?.querySelector<HTMLElement>(".bay-say");
      const fits = pin.offsetHeight < window.innerHeight - 112;
      pin.toggleAttribute("data-pinned", wide && fits && (say?.offsetHeight ?? 0) > pin.offsetHeight);
    }
  };
  const observePins = () => {
    pinSectionCode();
    new ResizeObserver(pinSectionCode).observe(document.body);
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", observePins);
  else observePins();
  mountCanvases();
  document.addEventListener("astro:page-load", mountCanvases);
  mountCodeTabs();
  document.addEventListener("astro:page-load", mountCodeTabs);
  prepareReferenceStatus();
  document.addEventListener("astro:page-load", prepareReferenceStatus);
  prepareCopyButtons();
  document.addEventListener("astro:page-load", prepareCopyButtons);
  document.addEventListener("keydown", (event) => {
    if (!(event.target instanceof HTMLElement) || !event.target.matches("celestia-code-copy-button")) return;
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    event.target.click();
  });
</script>
