---
import blackLogo from "../assets/outpost-symbol-black.png";
import whiteLogo from "../assets/outpost-symbol-white.png";
interface Props {
  href: string;
  suffix?: string;
  class?: string;
  iconOnly?: boolean;
}

const { href, suffix, class: className, iconOnly = false } = Astro.props;
---

<a
  class:list={["brand", className]}
  href={href}
  translate="no"
  aria-label={iconOnly ? "Outpost" : undefined}
>
  <img class="mark mark-light" src={blackLogo.src} width={blackLogo.width} height={blackLogo.height} alt="" aria-hidden="true" />
  <img class="mark mark-dark" src={whiteLogo.src} width={whiteLogo.width} height={whiteLogo.height} alt="" aria-hidden="true" />
  {!iconOnly && <span class="name">Outpost</span>}
  {suffix && <span class="suffix">{suffix}</span>}
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--sl-color-white);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    flex: 0 0 auto;
    align-self: center;
    display: block;
    width: 1.5em;
    height: 1.5em;
    object-fit: contain;
  }
  .suffix {
    margin-left: 0.1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .mark-dark,
  :global([data-theme="dark"]) .mark-light {
    display: none;
  }
  :global([data-theme="dark"]) .mark-dark {
    display: block;
  }
</style>
