---
import { getEntry } from "astro:content";
import { referenceFamilies } from "../../scripts/reference-navigation.mjs";
import { docsHref, isFrench } from "./docs-route.ts";

const route = Astro.locals.starlightRoute;
const locale = isFrench(route) ? "fr/" : "";
const overviewLabel = isFrench(route) ? "Vue d’ensemble" : "Overview";
const families = await Promise.all(
  referenceFamilies.map(async (section) => ({
    label: section.label,
    families: await Promise.all(
      section.families.map(async (family) => {
        const entry = await getEntry("docs", `${locale}${family.overview}`);
        return {
          label: family.label,
          overview: docsHref(route, `${family.overview}/`),
          summary: entry?.data.description.match(/^.*?[.!?](\s|$)/)?.[0].trim(),
          functions: family.symbols
            .filter((item) => item.attrs["data-api-kind"] === "function")
            .slice(0, 3)
            .map((item) => ({ label: item.label, href: docsHref(route, `${item.slug}/`) })),
        };
      }),
    ),
  })),
);
---

{
  families.map((section, index) => (
    <section class="bay reference-map" data-bay="split" aria-labelledby={`map-${index}`}>
      <div class="bay-say">
        <h2 id={`map-${index}`}>{section.label}</h2>
      </div>
      <div class="bay-show">
        <ul class="families not-content">
          {section.families.map((family) => (
            <li>
              <a class="family" href={family.overview}>
                <span class="family-name">{family.label}</span>
                {family.summary && <span class="family-summary">{family.summary}</span>}
                <span class="family-overview">{overviewLabel}</span>
              </a>
              {family.functions.length > 0 && (
                <ul class="entry-points">
                  {family.functions.map((item) => (
                    <li>
                      <a href={item.href}>
                        <code>{item.label}()</code>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))
}

<style>
  .reference-map .bay-say {
    align-self: start;
    position: sticky;
    top: 4rem;
  }
  .reference-map .bay-show {
    padding: 0;
  }
  .families {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .families > li {
    display: flex;
    flex-direction: column;
    margin: 0;
    border-bottom: 1px solid var(--docs-line);
  }
  .families > li:nth-child(odd) {
    border-right: 1px solid var(--docs-line);
  }
  .families > li:last-child,
  .families > li:nth-last-child(2):nth-child(odd) {
    border-bottom: 0;
  }
  .family {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.4rem var(--docs-pad) 0.9rem;
    text-decoration: none;
    transition: background-color 0.2s var(--docs-ease);
  }
  .family:hover {
    background: var(--docs-code-bg);
  }
  .family-name {
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .family-summary {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .family-overview {
    margin-top: 0.3rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-decoration-color: var(--sl-color-gray-4);
    text-underline-offset: 0.22em;
  }
  .entry-points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin: 0;
    padding: 0 var(--docs-pad) 1.3rem;
    list-style: none;
  }
  .entry-points li {
    margin: 0;
  }
  .entry-points a {
    text-decoration: none;
  }
  .entry-points code {
    padding: 0;
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
  }
  .entry-points a:hover code {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  @media (max-width: 64rem) {
    .reference-map .bay-say {
      position: static;
      padding-bottom: 1.25rem;
    }
    .families {
      border-top: 1px solid var(--docs-line);
    }
  }
  @media (max-width: 40rem) {
    .families {
      grid-template-columns: minmax(0, 1fr);
    }
    .families > li {
      border-right: 0 !important;
      border-bottom: 1px solid var(--docs-line) !important;
    }
  }
</style>
