---
import Identifier from "./Identifier.astro";
import NavFooter from "./NavFooter.astro";

const route = Astro.locals.starlightRoute;
const reference = route.sidebar[1];
const links = reference?.type === "group" ? reference.entries : [];
---

<div class="docs-navigation reference-navigation">
  <ul class="reference-symbols">
    {
      links.map(
        (link) =>
          link.type === "link" && (
            <li>
              <a href={link.href} aria-current={link.isCurrent ? "page" : undefined} {...link.attrs}>
                <span class="label">
                  <Identifier name={link.label} />
                </span>
              </a>
            </li>
          ),
      )
    }
  </ul>
  <NavFooter />
</div>

<style>
  .label {
    min-width: 0;
  }
</style>
