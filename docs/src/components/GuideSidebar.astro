---
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import NavFooter from "./NavFooter.astro";
import { currentLink, isFrench } from "./docs-route.ts";
import { tiers } from "../../scripts/navigation.mjs";

const route = Astro.locals.starlightRoute;
const guide = route.sidebar[0];
const tierLabels = new Map<number, string>();
let start = 0;
for (const [english, french, list] of tiers) {
  tierLabels.set(start, isFrench(route) ? french : english);
  start += list.length;
}
---

<div class="docs-navigation">
  {
    guide?.type === "group" &&
      guide.entries.map(
        (group, index) =>
          group.type === "group" && (
            <section>
              {tierLabels.has(index) && (
                <p class="docs-tier">{tierLabels.get(index)}</p>
              )}
              <details open={index === 0 || Boolean(currentLink(group.entries))}>
                <summary>
                  <h2>{group.label}</h2>
                </summary>
                <SidebarSublist sublist={group.entries} />
              </details>
            </section>
          ),
      )
  }
  <NavFooter />
</div>
