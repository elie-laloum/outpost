---
import SidebarSublist from "@astrojs/starlight/components/SidebarSublist.astro";
import NavFooter from "./NavFooter.astro";

const guide = Astro.locals.starlightRoute.sidebar[0];
---

<div class="docs-navigation">
  {
    guide?.type === "group" &&
      guide.entries.map(
        (group) =>
          group.type === "group" && (
            <section>
              <h2>{group.label}</h2>
              <SidebarSublist sublist={group.entries} />
            </section>
          ),
      )
  }
  <NavFooter />
</div>
