---
import { Icon } from "@astrojs/starlight/components";
import { isFrench } from "./docs-route.ts";

const route = Astro.locals.starlightRoute;
const french = isFrench(route);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// The not-found page has no translated twin: offer the other language's home.
const path = /(^|\/)404$/.test(route.entry.id)
  ? "/"
  : Astro.url.pathname.slice(base.length) || "/";
const target = french ? path.replace(/^\/fr(\/|$)/, "/") : `/fr${path}`;
const current = french ? "FR" : "EN";
const other = french
  ? { name: "English", code: "EN", lang: "en" }
  : { name: "Français", code: "FR", lang: "fr" };
---

<div class="language-cell">
  <Icon name="translate" size="1rem" class="language-icon" />
  <span class="current" aria-hidden="true">{current}</span>
  <a class="language" href={`${base}${target}`} hreflang={other.lang} lang={other.lang}>
    <span class="name">{other.name}</span>
    <span class="code" aria-hidden="true">{other.code}</span>
  </a>
</div>

<style>
  .language-cell {
    display: flex;
    align-items: center;
    height: 100%;
    padding-left: 0.9rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .language-cell :global(.language-icon) {
    margin-right: 0.45rem;
  }
  .current {
    display: none;
    color: var(--sl-color-white);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .language {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 0.9rem 0 0.2rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition:
      color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .language:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .language:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .code {
    display: none;
    letter-spacing: 0.02em;
  }
  @media (max-width: 79.99rem) {
    .current {
      display: inline;
    }
    .language {
      padding-left: 0.6rem;
    }
    .name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .code {
      display: inline;
    }
  }
</style>
