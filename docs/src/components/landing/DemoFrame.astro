---
interface Props {
  tag: string;
  id: string;
  title: string;
  pause?: string;
  replay?: string;
  beatsLabel?: string;
  beats?: readonly string[];
  summary?: readonly string[];
}

const {
  tag,
  id,
  title,
  pause,
  replay,
  beatsLabel,
  beats,
  summary,
} = Astro.props;
const Tag = tag;
---

<Tag class="demo" data-beat="0">
  <figure aria-labelledby={`${id}-title`}>
    <div class="demo-bar">
      <slot name="bar">
        <p class="demo-title" id={`${id}-title`}>{title}</p>
      </slot>
      {
        beats && (
          <button
            type="button"
            class="demo-toggle"
            data-toggle
            data-pause={pause}
            data-replay={replay}
            aria-label={replay}
            title={replay}
            hidden
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="pause-icon">
              <path d="M9 6v12M15 6v12" />
            </svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="replay-icon">
              <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3" />
              <path d="M4.5 4.5v3.2h3.2" />
            </svg>
          </button>
        )
      }
    </div>
    {
      summary && (
        <ul class="demo-summary">
          {summary.map((line) => (
            <li>{line}</li>
          ))}
        </ul>
      )
    }
    <slot />
    <slot name="foot">
      <div class="beats" role="group" aria-label={beatsLabel}>
        {
          beats?.map((beat, index) => (
            <button
              type="button"
              data-beat={index}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              {beat}
            </button>
          ))
        }
      </div>
    </slot>
  </figure>
</Tag>

<style>
  .demo {
    --demo-pad: clamp(1rem, 2vw, 1.5rem);
    display: block;
    border: 1px solid var(--landing-line);
    background: var(--landing-code-bg);
  }
  figure {
    margin: 0;
  }
  .demo-bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--landing-line);
  }
  .demo-title {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0 var(--demo-pad);
    color: var(--sl-color-white);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .demo-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    flex: 0 0 2.75rem;
    margin-left: auto;
    border: 0;
    border-left: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .demo-toggle[hidden] {
    display: none;
  }
  .demo-toggle:hover {
    color: var(--sl-color-white);
  }
  .demo-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pause-icon,
  .demo[data-state="playing"] .replay-icon {
    display: none;
  }
  .demo[data-state="playing"] .pause-icon {
    display: block;
  }
  .demo-summary {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .beats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--landing-line);
  }
  .beats button {
    position: relative;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    border-right: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s var(--landing-ease),
      color 0.2s var(--landing-ease);
  }
  .beats button:last-child {
    border-right: 0;
  }
  .beats button:hover {
    color: var(--sl-color-white);
  }
  .beats button[aria-pressed="true"] {
    background: var(--landing-code-bg-active);
    color: var(--sl-color-white);
  }
  .beats button::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--sl-color-white);
    transform: scaleX(0);
    transform-origin: left;
  }
  .beats button[aria-pressed="true"]::after {
    transform: scaleX(1);
  }
  .demo[data-state="playing"] .beats button[aria-pressed="true"]::after {
    transform: scaleX(0);
  }
  .demo[data-state="playing"][data-timed]
    .beats
    button[aria-pressed="true"]::after {
    transform: scaleX(1);
    transition: transform var(--beat-ms) linear;
  }
  .beats button:focus-visible,
  .demo-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .demo[data-instant] :global(*) {
    transition: none !important;
  }
  @media (max-width: 40rem) {
    .demo {
      --demo-pad: 1.25rem;
      border-inline: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo :global(*) {
      transition: none !important;
    }
  }
</style>
