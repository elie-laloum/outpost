---
import type { CollectionEntry } from "astro:content";

type Demo = NonNullable<CollectionEntry<"docs">["data"]["landing"]>["demo"];

interface Props {
  demo: Demo;
}

const { demo } = Astro.props;
const lanes = [
  {
    key: "model",
    lane: demo.model,
    owners: demo.steps.map(() => "model"),
    fill: 1,
  },
  {
    key: "code",
    lane: demo.code,
    owners: demo.steps.map((_, index) => (index === 1 ? "agent" : "code")),
    fill: 0.25,
  },
] as const;
---

<outpost-demo class="demo" data-beat="0">
  <figure aria-labelledby="demo-title">
    <div class="demo-bar">
      <p class="demo-title" id="demo-title">{demo.title}</p>
      <button
        type="button"
        class="demo-toggle"
        data-toggle
        data-pause={demo.pause}
        data-replay={demo.replay}
        aria-label={demo.replay}
        title={demo.replay}
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="pause-icon">
          <path d="M9 6v12M15 6v12"></path>
        </svg>
        <svg viewBox="0 0 24 24" aria-hidden="true" class="replay-icon">
          <path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3"></path>
          <path d="M4.5 4.5v3.2h3.2"></path>
        </svg>
      </button>
    </div>
    <ul class="demo-summary">
      {
        demo.beats.map((beat, index) => (
          <li>
            {beat}. {demo.model.title}: {demo.model.captions[index]}{" "}
            {demo.code.title}: {demo.code.captions[index]}
          </li>
        ))
      }
    </ul>
    <div class="stage" aria-hidden="true">
      {
        lanes.map(({ key, lane, owners, fill }) => (
          <div class="lane" data-lane={key}>
            <div class="lane-head">
              <p class="lane-title">{lane.title}</p>
              <p class="lane-caption">
                {lane.captions.map((caption, index) => (
                  <span data-caption={index}>{caption}</span>
                ))}
              </p>
            </div>
            <ol class="lane-steps">
              {demo.steps.map((step, index) => (
                <li class="step" data-state="done" data-owner={owners[index]}>
                  <span class="step-name">{step}</span>
                  <span class="step-tag">{demo.owners[owners[index]]}</span>
                  <span class="step-notes">
                    <span data-note="early">{demo.notes.early}</span>
                    <span data-note="reread">{demo.notes.reread}</span>
                    <span data-note="restored">{demo.notes.restored}</span>
                  </span>
                  <svg viewBox="0 0 24 24" class="step-check">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                </li>
              ))}
            </ol>
            <div class="meter">
              <span class="meter-label">{lane.context}</span>
              <span class="meter-track">
                <span class="meter-fill" style={`--fill: ${fill}`} />
              </span>
            </div>
          </div>
        ))
      }
      <div class="cut"><span>{demo.interrupted}</span></div>
    </div>
    <div class="beats" role="group" aria-label={demo.beatsLabel}>
      {
        demo.beats.map((beat, index) => (
          <button
            type="button"
            data-beat={index}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {beat}
          </button>
        ))
      }
    </div>
  </figure>
</outpost-demo>

<script>
  type Lane = { steps: HTMLElement[]; fill: HTMLElement };

  const MODEL_STEP = 520;
  const CODE_STEP = 160;
  const AGENT_STEP = 1100;
  const HOLD = 1300;

  class OutpostDemo extends HTMLElement {
    #timers: number[] = [];
    #lanes: Record<"model" | "code", Lane> = {
      model: { steps: [], fill: this },
      code: { steps: [], fill: this },
    };

    connectedCallback() {
      for (const key of ["model", "code"] as const) {
        const lane = this.querySelector<HTMLElement>(`[data-lane="${key}"]`);
        this.#lanes[key] = {
          steps: [...(lane?.querySelectorAll<HTMLElement>(".step") ?? [])],
          fill: lane?.querySelector<HTMLElement>(".meter-fill") ?? this,
        };
      }
      const still = matchMedia("(prefers-reduced-motion: reduce)");
      const toggle = this.querySelector<HTMLButtonElement>("[data-toggle]");
      const beats = [
        ...this.querySelectorAll<HTMLButtonElement>("button[data-beat]"),
      ];
      beats.forEach((button, beat) =>
        button.addEventListener("click", () => {
          this.#stop();
          if (still.matches) this.#show(beat);
          else this.#play(beat, false);
        }),
      );
      if (still.matches || !toggle) return;
      toggle.hidden = false;
      toggle.addEventListener("click", () => {
        if (this.dataset.state === "playing") {
          this.#stop();
          this.#show(Number(this.dataset.beat));
        } else this.#play(0, true);
      });
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          this.#play(0, true);
        },
        { threshold: 0.35 },
      ).observe(this);
    }

    #at(ms: number, action: () => void) {
      this.#timers.push(window.setTimeout(action, ms));
    }

    #stop() {
      this.#timers.forEach((timer) => clearTimeout(timer));
      this.#timers = [];
      this.#setState("stopped");
    }

    #setState(state: "playing" | "stopped") {
      this.dataset.state = state;
      const toggle = this.querySelector<HTMLButtonElement>("[data-toggle]");
      if (!toggle) return;
      const label =
        state === "playing" ? toggle.dataset.pause : toggle.dataset.replay;
      toggle.setAttribute("aria-label", label ?? "");
      toggle.title = label ?? "";
    }

    #select(beat: number, duration = 0) {
      this.dataset.beat = String(beat);
      this.querySelectorAll("button[data-beat]").forEach((button, index) => {
        button.setAttribute("aria-pressed", String(index === beat));
      });
      this.style.setProperty("--beat-ms", `${duration}ms`);
      this.toggleAttribute("data-timed", false);
      if (duration) requestAnimationFrame(() => this.toggleAttribute("data-timed", true));
    }

    #step(lane: "model" | "code", index: number, state: string, note = "") {
      const step = this.#lanes[lane].steps[index];
      if (!step) return;
      step.dataset.state = state;
      step.dataset.note = note;
    }

    #fill(lane: "model" | "code", value: number) {
      this.#lanes[lane].fill.style.setProperty("--fill", String(value));
    }

    #reset() {
      for (const lane of ["model", "code"] as const) {
        this.#lanes[lane].steps.forEach((_, index) => this.#step(lane, index, "idle"));
        this.#fill(lane, 0);
      }
      this.toggleAttribute("data-drift", false);
      this.toggleAttribute("data-cut", false);
    }

    // Each step lights while it runs; a model spends a turn on every step it owns.
    #run(lane: "model" | "code", order: number[], start: number, note = "", filled = 0) {
      let time = start;
      order.forEach((index, position) => {
        const owner = this.#lanes[lane].steps[index]?.dataset.owner;
        const duration =
          owner === "model" ? MODEL_STEP : owner === "agent" ? AGENT_STEP : CODE_STEP;
        this.#at(time, () => {
          this.#lanes[lane].steps[index]?.style.setProperty("--run", `${duration}ms`);
          this.#step(lane, index, "active", note);
          if (owner === "agent") this.#fill(lane, 0.25);
        });
        time += duration;
        this.#at(time, () => {
          this.#step(lane, index, "done", note);
          if (owner === "model") this.#fill(lane, (filled + position + 1) / 4);
        });
      });
      return time;
    }

    #timeline(beat: number) {
      if (beat < 2) return Math.max(this.#run("model", [0, 1, 2, 3], 150), this.#run("code", [0, 1, 2, 3], 150));
      if (beat === 2) {
        this.#at(80, () => this.toggleAttribute("data-drift", true));
        const start = 650;
        return Math.max(this.#runDrifted(start), this.#run("code", [0, 1, 2, 3], start));
      }
      const cut = Math.max(this.#run("model", [0, 1], 150), this.#run("code", [0, 1], 150)) + 250;
      this.#at(cut, () => this.toggleAttribute("data-cut", true));
      const resume = cut + 800;
      this.#at(resume, () => {
        this.#step("model", 0, "idle");
        this.#step("model", 1, "idle");
        this.#fill("model", 0);
        this.#step("code", 0, "done", "restored");
        this.#step("code", 1, "done", "restored");
      });
      const reread = this.#run("model", [0, 1], resume + 350, "reread");
      return Math.max(this.#run("model", [2, 3], reread, "", 2), this.#run("code", [2, 3], resume + 350));
    }

    #runDrifted(start: number) {
      let time = start;
      [0, 1, 3, 2].forEach((index, position) => {
        const note = index === 3 ? "early" : "";
        this.#at(time, () => {
          this.#lanes.model.steps[index]?.style.setProperty("--run", `${MODEL_STEP}ms`);
          this.#step("model", index, "active", note);
        });
        time += MODEL_STEP;
        this.#at(time, () => {
          this.#step("model", index, "done", note);
          this.#fill("model", (position + 1) / 4);
        });
      });
      return time;
    }

    #play(beat: number, chain: boolean) {
      this.#stop();
      this.#reset();
      this.#setState("playing");
      const end = this.#timeline(beat) + HOLD;
      this.#select(beat, end);
      this.#at(end, () => {
        if (chain && beat < 3) this.#play(beat + 1, true);
        else this.#setState("stopped");
      });
    }

    #show(beat: number) {
      this.toggleAttribute("data-instant", true);
      this.#reset();
      this.#select(beat);
      for (const lane of ["model", "code"] as const)
        this.#lanes[lane].steps.forEach((_, index) => this.#step(lane, index, "done"));
      this.#fill("model", 1);
      this.#fill("code", 0.25);
      if (beat === 2) {
        this.toggleAttribute("data-drift", true);
        this.#step("model", 3, "done", "early");
      }
      if (beat === 3) {
        this.toggleAttribute("data-cut", true);
        [0, 1].forEach((index) => {
          this.#step("model", index, "done", "reread");
          this.#step("code", index, "done", "restored");
        });
      }
      requestAnimationFrame(() => this.toggleAttribute("data-instant", false));
    }
  }
  customElements.define("outpost-demo", OutpostDemo);
</script>

<style>
  .demo {
    --demo-pad: clamp(1rem, 2vw, 1.5rem);
    display: block;
    border: 1px solid var(--landing-line);
    background: var(--landing-code-bg);
  }
  figure {
    margin: 0;
  }
  .demo-bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--landing-line);
  }
  .demo-title {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0 var(--demo-pad);
    color: var(--sl-color-white);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .demo-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    flex: 0 0 2.75rem;
    border: 0;
    border-left: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .demo-toggle[hidden] {
    display: none;
  }
  .demo-toggle:hover {
    color: var(--sl-color-white);
  }
  .demo svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pause-icon,
  .demo[data-state="playing"] .replay-icon {
    display: none;
  }
  .demo[data-state="playing"] .pause-icon {
    display: block;
  }
  .demo-summary {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .stage {
    position: relative;
  }
  .lane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.35rem var(--demo-pad) 1.25rem;
  }
  .lane + .lane {
    border-top: 1px solid var(--landing-line);
  }
  .lane-head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .lane-title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* Captions share one cell so switching beats never shifts the layout. */
  .lane-caption {
    display: grid;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  /* Text knocks out the interruption line where they cross. */
  .lane-title,
  .lane-caption span {
    position: relative;
    z-index: 1;
    justify-self: start;
    background: var(--landing-code-bg);
  }
  .lane-title {
    align-self: flex-start;
  }
  .lane-caption span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.35s var(--landing-ease);
  }
  .demo[data-beat="0"] [data-caption="0"],
  .demo[data-beat="1"] [data-caption="1"],
  .demo[data-beat="2"] [data-caption="2"],
  .demo[data-beat="3"] [data-caption="3"] {
    opacity: 1;
  }

  /* One-pixel gaps over the line colour draw the dividers and survive the drift swap. */
  .lane-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--landing-line);
    background: var(--landing-line);
    list-style: none;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    min-width: 0;
    padding: 0.8rem 0.8rem 0.7rem;
    background: var(--sl-color-black);
    transition:
      background-color 0.25s var(--landing-ease),
      transform 0.5s var(--landing-ease);
  }
  .step::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--sl-color-gray-3);
    transform: scaleX(0);
    transform-origin: left;
  }
  .step[data-state="active"] {
    background: var(--landing-code-bg-active);
  }
  .step[data-state="active"]::after {
    transform: scaleX(1);
    transition: transform var(--run, 0.3s) linear;
  }
  .step:is([data-owner="model"], [data-owner="agent"])[data-state="active"] {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, var(--sl-color-black));
  }
  .step:is([data-owner="model"], [data-owner="agent"])::after {
    background: var(--sl-color-accent);
  }
  .step-name {
    max-width: 100%;
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .step-tag {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    line-height: 1.3;
    transition:
      color 0.3s var(--landing-ease),
      border-color 0.3s var(--landing-ease);
  }
  /* A model's turn is filled ink; code stays outlined, so the split reads at rest. */
  .step:is([data-owner="model"], [data-owner="agent"]) .step-tag {
    border-color: var(--sl-color-white);
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .step-notes {
    display: grid;
    min-height: 1.2em;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
  }
  .step-notes span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.3s var(--landing-ease);
  }
  .step[data-note="early"] [data-note="early"],
  .step[data-note="reread"] [data-note="reread"],
  .step[data-note="restored"] [data-note="restored"] {
    opacity: 1;
    color: var(--sl-color-white);
  }
  .step-check {
    position: absolute;
    top: 0.8rem;
    right: 0.7rem;
    color: var(--sl-color-white);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.25s var(--landing-ease),
      transform 0.35s var(--landing-ease);
  }
  .step[data-state="done"] .step-check {
    opacity: 1;
    transform: none;
  }
  /* Code's graph is fixed: chevrons on its dividers. The model's order is not. */
  [data-lane="code"] .step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 1.1rem;
    right: calc(-0.35rem - 0.5px);
    z-index: 1;
    width: 0.6rem;
    height: 0.6rem;
    border-top: 1px solid var(--sl-color-gray-4);
    border-right: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-black);
    transform: rotate(45deg);
    transition: border-color 0.3s var(--landing-ease);
  }
  .demo[data-drift] [data-lane="model"] .step:nth-child(3) {
    transform: translateX(calc(100% + 1px));
  }
  .demo[data-drift] [data-lane="model"] .step:nth-child(4) {
    transform: translateX(calc(-100% - 1px));
  }

  .meter {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .meter-label {
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition: color 0.3s var(--landing-ease);
  }
  .meter-track {
    height: 0.5rem;
    border: 1px solid var(--landing-line);
  }
  .meter-fill {
    display: block;
    height: 100%;
    background: var(--sl-color-gray-3);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
    transition:
      transform 0.5s var(--landing-ease),
      background-color 0.3s var(--landing-ease);
  }

  .cut {
    position: absolute;
    inset: 0 auto 0 50%;
    border-left: 1px dashed var(--sl-color-white);
    clip-path: inset(0 -10rem 100% -10rem);
    transition: clip-path 0.6s var(--landing-ease);
    pointer-events: none;
  }
  .cut span {
    position: absolute;
    top: -0.7rem;
    left: 0;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--sl-color-white);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transform: translateX(-50%);
  }
  .demo[data-cut] .cut {
    clip-path: inset(-1rem -10rem 0 -10rem);
  }

  /* Each beat puts ink on the part of the lanes it explains. */
  .demo[data-beat="0"] [data-owner="code"] .step-tag {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  .demo[data-beat="1"] .meter-label {
    color: var(--sl-color-white);
  }
  .demo[data-beat="1"] .meter-fill {
    background: var(--sl-color-white);
  }
  .demo[data-beat="2"] [data-lane="code"] .step::before {
    border-color: var(--sl-color-white);
  }

  .beats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--landing-line);
  }
  .beats button {
    position: relative;
    min-height: 2.75rem;
    padding: 0 0.5rem;
    border: 0;
    border-right: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.2s var(--landing-ease),
      color 0.2s var(--landing-ease);
  }
  .beats button:last-child {
    border-right: 0;
  }
  .beats button:hover {
    color: var(--sl-color-white);
  }
  .beats button[aria-pressed="true"] {
    background: var(--landing-code-bg-active);
    color: var(--sl-color-white);
  }
  .beats button::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--sl-color-white);
    transform: scaleX(0);
    transform-origin: left;
  }
  .beats button[aria-pressed="true"]::after {
    transform: scaleX(1);
  }
  .demo[data-state="playing"] .beats button[aria-pressed="true"]::after {
    transform: scaleX(0);
  }
  .demo[data-state="playing"][data-timed] .beats button[aria-pressed="true"]::after {
    transform: scaleX(1);
    transition: transform var(--beat-ms) linear;
  }
  .beats button:focus-visible,
  .demo-toggle:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }

  .demo[data-instant] :is(.step, .step::after, .step-check, .meter-fill, .cut, .lane-caption span, .step-notes span) {
    transition: none;
  }

  @media (max-width: 40rem) {
    .demo {
      --demo-pad: 1.25rem;
      border-inline: 0;
    }
    .step {
      padding: 0.7rem 0.4rem 0.6rem 0.75rem;
    }
    .step-name {
      font-size: 0.75rem;
    }
    [data-lane="code"] .step:not(:last-child)::before {
      top: 0.85rem;
    }
    .step-check {
      top: auto;
      right: 0.4rem;
      bottom: 0.55rem;
      width: 0.8rem;
      height: 0.8rem;
    }
    .step-tag {
      padding-inline: 0.3rem;
      font-size: 0.6875rem;
    }
    .meter {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.45rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo * {
      transition: none !important;
    }
  }
</style>
