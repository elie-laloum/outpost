---
import type { CollectionEntry } from "astro:content";
import DemoFrame from "./DemoFrame.astro";

type Demo = NonNullable<CollectionEntry<"docs">["data"]["landing"]>["demo"];

interface Props {
  demo: Demo;
}

const { demo } = Astro.props;
const lanes = [
  {
    key: "model",
    lane: demo.model,
    owners: demo.steps.map(() => "model"),
    fill: 1,
  },
  {
    key: "code",
    lane: demo.code,
    owners: demo.steps.map((_, index) => (index === 1 ? "agent" : "code")),
    fill: 0.25,
  },
] as const;
const summary = demo.beats.map(
  (beat, index) =>
    `${beat}. ${demo.model.title}: ${demo.model.captions[index]} ${demo.code.title}: ${demo.code.captions[index]}`,
);
---

<DemoFrame
  tag="outpost-demo"
  id="demo"
  title={demo.title}
  pause={demo.pause}
  replay={demo.replay}
  beatsLabel={demo.beatsLabel}
  beats={demo.beats}
  summary={summary}
>
  <div class="stage" aria-hidden="true">
    {
      lanes.map(({ key, lane, owners, fill }) => (
        <div class="lane" data-lane={key}>
          <div class="lane-head">
            <p class="lane-title">{lane.title}</p>
            <p class="lane-caption">
              {lane.captions.map((caption, index) => (
                <span data-caption={index}>{caption}</span>
              ))}
            </p>
          </div>
          <ol class="lane-steps">
            {demo.steps.map((step, index) => (
              <li class="step" data-state="done" data-owner={owners[index]}>
                <span class="step-name">{step}</span>
                <span class="step-tag">{demo.owners[owners[index]]}</span>
                <span class="step-notes">
                  <span data-note="early">{demo.notes.early}</span>
                  <span data-note="reread">{demo.notes.reread}</span>
                  <span data-note="restored">{demo.notes.restored}</span>
                </span>
                <svg viewBox="0 0 24 24" class="step-check">
                  <path d="m5 12.5 4.5 4.5L19 7.5" />
                </svg>
              </li>
            ))}
          </ol>
          <div class="meter">
            <span class="meter-label">{lane.context}</span>
            <span class="meter-track">
              <span class="meter-fill" style={`--fill: ${fill}`} />
            </span>
          </div>
        </div>
      ))
    }
    <div class="cut"><span>{demo.interrupted}</span></div>
  </div>
</DemoFrame>

<script>
  import { DemoPlayer } from "./demo-player.ts";

  type LaneKey = "model" | "code";
  type Lane = { steps: HTMLElement[]; fill: HTMLElement };

  const MODEL_STEP = 520;
  const CODE_STEP = 160;
  const AGENT_STEP = 1100;
  // Ember at half the context window, red at three quarters.
  const LEVELS = [
    { from: 0.75, level: "high" },
    { from: 0.5, level: "mid" },
    { from: 0, level: "low" },
  ];

  class OutpostDemo extends DemoPlayer {
    #lanes: Record<LaneKey, Lane> = {
      model: { steps: [], fill: this },
      code: { steps: [], fill: this },
    };

    connectedCallback() {
      for (const key of ["model", "code"] as const) {
        const lane = this.querySelector<HTMLElement>(`[data-lane="${key}"]`);
        this.#lanes[key] = {
          steps: [...(lane?.querySelectorAll<HTMLElement>(".step") ?? [])],
          fill: lane?.querySelector<HTMLElement>(".meter-fill") ?? this,
        };
      }
      super.connectedCallback();
    }

    #step(lane: LaneKey, index: number, state: string, note = "") {
      const step = this.#lanes[lane].steps[index];
      if (!step) return;
      step.dataset.state = state;
      step.dataset.note = note;
    }

    #fill(lane: LaneKey, value: number) {
      const { fill } = this.#lanes[lane];
      fill.style.setProperty("--fill", String(value));
      fill.dataset.level = LEVELS.find((step) => value >= step.from)!.level;
    }

    protected reset() {
      for (const lane of ["model", "code"] as const) {
        this.#lanes[lane].steps.forEach((_, index) =>
          this.#step(lane, index, "idle"),
        );
        this.#fill(lane, 0);
      }
      this.toggleAttribute("data-drift", false);
      this.toggleAttribute("data-cut", false);
    }

    // Each step lights while it runs; a model spends a turn on every step it owns.
    #run(lane: LaneKey, order: number[], start: number, note = "", filled = 0) {
      let time = start;
      order.forEach((index, position) => {
        const owner = this.#lanes[lane].steps[index]?.dataset.owner;
        const duration =
          owner === "model"
            ? MODEL_STEP
            : owner === "agent"
              ? AGENT_STEP
              : CODE_STEP;
        this.at(time, () => {
          this.#lanes[lane].steps[index]?.style.setProperty(
            "--run",
            `${duration}ms`,
          );
          this.#step(lane, index, "active", note);
          if (owner === "agent") this.#fill(lane, 0.25);
        });
        time += duration;
        this.at(time, () => {
          this.#step(lane, index, "done", note);
          if (owner === "model") this.#fill(lane, (filled + position + 1) / 4);
        });
      });
      return time;
    }

    #runDrifted(start: number) {
      let time = start;
      [0, 1, 3, 2].forEach((index, position) => {
        const note = index === 3 ? "early" : "";
        this.at(time, () => {
          this.#lanes.model.steps[index]?.style.setProperty(
            "--run",
            `${MODEL_STEP}ms`,
          );
          this.#step("model", index, "active", note);
        });
        time += MODEL_STEP;
        this.at(time, () => {
          this.#step("model", index, "done", note);
          this.#fill("model", (position + 1) / 4);
        });
      });
      return time;
    }

    protected timeline(beat: number) {
      const all = [0, 1, 2, 3];
      if (beat < 2)
        return Math.max(
          this.#run("model", all, 150),
          this.#run("code", all, 150),
        );
      if (beat === 2) {
        this.at(80, () => this.toggleAttribute("data-drift", true));
        return Math.max(this.#runDrifted(650), this.#run("code", all, 650));
      }
      const cut =
        Math.max(this.#run("model", [0, 1], 150), this.#run("code", [0, 1], 150)) +
        250;
      this.at(cut, () => this.toggleAttribute("data-cut", true));
      const resume = cut + 800;
      this.at(resume, () => {
        this.#step("model", 0, "idle");
        this.#step("model", 1, "idle");
        this.#fill("model", 0);
        this.#step("code", 0, "done", "restored");
        this.#step("code", 1, "done", "restored");
      });
      const reread = this.#run("model", [0, 1], resume + 350, "reread");
      return Math.max(
        this.#run("model", [2, 3], reread, "", 2),
        this.#run("code", [2, 3], resume + 350),
      );
    }

    protected settle(beat: number) {
      this.reset();
      for (const lane of ["model", "code"] as const)
        this.#lanes[lane].steps.forEach((_, index) =>
          this.#step(lane, index, "done"),
        );
      this.#fill("model", 1);
      this.#fill("code", 0.25);
      if (beat === 2) {
        this.toggleAttribute("data-drift", true);
        this.#step("model", 3, "done", "early");
      }
      if (beat === 3) {
        this.toggleAttribute("data-cut", true);
        [0, 1].forEach((index) => {
          this.#step("model", index, "done", "reread");
          this.#step("code", index, "done", "restored");
        });
      }
    }
  }
  customElements.define("outpost-demo", OutpostDemo);
</script>

<style>
  .stage {
    position: relative;
  }
  .lane {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.35rem var(--demo-pad) 1.25rem;
  }
  .lane + .lane {
    border-top: 1px solid var(--landing-line);
  }
  .lane-head {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .lane-title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  /* Captions share one cell so switching beats never shifts the layout. */
  .lane-caption {
    display: grid;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  /* Text knocks out the interruption line where they cross. */
  .lane-title,
  .lane-caption span {
    position: relative;
    z-index: 1;
    justify-self: start;
    background: var(--landing-code-bg);
  }
  .lane-title {
    align-self: flex-start;
  }
  .lane-caption span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.35s var(--landing-ease);
  }
  :global(.demo[data-beat="0"]) [data-caption="0"],
  :global(.demo[data-beat="1"]) [data-caption="1"],
  :global(.demo[data-beat="2"]) [data-caption="2"],
  :global(.demo[data-beat="3"]) [data-caption="3"] {
    opacity: 1;
  }

  /* One-pixel gaps over the line colour draw the dividers and survive the drift swap. */
  .lane-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--landing-line);
    background: var(--landing-line);
    list-style: none;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-content: start;
    justify-items: start;
    gap: 0.45rem 0.6rem;
    min-width: 0;
    padding: 0.8rem 0.8rem 0.7rem;
    background: var(--sl-color-black);
    transition:
      background-color 0.25s var(--landing-ease),
      transform 0.5s var(--landing-ease);
  }
  .step::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--sl-color-gray-3);
    transform: scaleX(0);
    transform-origin: left;
  }
  .step[data-state="active"] {
    background: var(--landing-code-bg-active);
  }
  .step[data-state="active"]::after {
    transform: scaleX(1);
    transition: transform var(--run, 0.3s) linear;
  }
  .step:is([data-owner="model"], [data-owner="agent"])[data-state="active"] {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, var(--sl-color-black));
  }
  .step:is([data-owner="model"], [data-owner="agent"])::after {
    background: var(--sl-color-accent);
  }
  .step-name {
    max-width: 100%;
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .step-tag {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
    line-height: 1.3;
    transition:
      color 0.3s var(--landing-ease),
      border-color 0.3s var(--landing-ease);
  }
  /* A model's turn is filled ink; code stays outlined, so the split reads at rest. */
  .step:is([data-owner="model"], [data-owner="agent"]) .step-tag {
    border-color: var(--sl-color-white);
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .step-notes {
    display: grid;
    grid-column: 1 / -1;
    min-height: 1.2em;
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
  }
  .step-notes span {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.3s var(--landing-ease);
  }
  .step[data-note="early"] [data-note="early"],
  .step[data-note="reread"] [data-note="reread"],
  .step[data-note="restored"] [data-note="restored"] {
    opacity: 1;
    color: var(--sl-color-white);
  }
  /* The check sits on the notes row so long step names never meet it. */
  .step-check {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    grid-row: 1;
    grid-column: 2;
    justify-self: end;
    color: var(--sl-color-white);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 0.25s var(--landing-ease),
      transform 0.35s var(--landing-ease);
  }
  .step[data-state="done"] .step-check {
    opacity: 1;
    transform: none;
  }
  /* Code's graph is fixed: chevrons on its dividers. The model's order is not. */
  [data-lane="code"] .step:not(:last-child)::before {
    content: "";
    position: absolute;
    top: 1.1rem;
    right: calc(-0.35rem - 0.5px);
    z-index: 1;
    width: 0.6rem;
    height: 0.6rem;
    border-top: 1px solid var(--sl-color-gray-4);
    border-right: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-black);
    transform: rotate(45deg);
    transition: border-color 0.3s var(--landing-ease);
  }
  :global(.demo[data-drift]) [data-lane="model"] .step:nth-child(3) {
    transform: translateX(calc(100% + 1px));
  }
  :global(.demo[data-drift]) [data-lane="model"] .step:nth-child(4) {
    transform: translateX(calc(-100% - 1px));
  }

  .meter {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .meter-label {
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition: color 0.3s var(--landing-ease);
  }
  .meter-track {
    height: 0.5rem;
    border: 1px solid var(--landing-line);
  }
  .meter-fill {
    display: block;
    height: 100%;
    background: var(--sl-color-gray-3);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
    transition:
      transform 0.5s var(--landing-ease),
      background-color 0.3s var(--landing-ease);
  }

  /* A filling context window is the one place the demo warns. */
  .meter-fill[data-level="mid"] {
    background: var(--sl-color-accent);
  }
  .meter-fill[data-level="high"] {
    background: var(--sl-color-red);
  }

  .cut {
    position: absolute;
    inset: 0 auto 0 50%;
    border-left: 1px dashed var(--sl-color-white);
    clip-path: inset(0 -10rem 100% -10rem);
    transition: clip-path 0.6s var(--landing-ease);
    pointer-events: none;
  }
  .cut span {
    position: absolute;
    top: -0.7rem;
    left: 0;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--sl-color-white);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transform: translateX(-50%);
  }
  :global(.demo[data-cut]) .cut {
    clip-path: inset(-1rem -10rem 0 -10rem);
  }

  /* Each beat puts ink on the part of the lanes it explains. */
  :global(.demo[data-beat="0"]) [data-owner="code"] .step-tag {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }
  :global(.demo[data-beat="1"]) .meter-label {
    color: var(--sl-color-white);
  }
  :global(.demo[data-beat="1"]) .meter-fill[data-level="low"] {
    background: var(--sl-color-white);
  }
  :global(.demo[data-beat="2"]) [data-lane="code"] .step::before {
    border-color: var(--sl-color-white);
  }



  @media (max-width: 40rem) {
    .step {
      padding: 0.7rem 0.4rem 0.6rem 0.75rem;
    }
    .step-name {
      font-size: 0.75rem;
    }
    [data-lane="code"] .step:not(:last-child)::before {
      top: 0.85rem;
    }
    .step-check {
      width: 0.8rem;
      height: 0.8rem;
    }
    .step-tag {
      padding-inline: 0.3rem;
      font-size: 0.6875rem;
    }
    .meter {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.45rem;
    }
  }
</style>
