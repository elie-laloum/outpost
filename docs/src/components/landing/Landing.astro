---
import Code from "starlight-theme-celestia/components/Code.astro";
import manifest from "../../../../package.json";
import Brand from "../Brand.astro";
import Arrow from "./Arrow.astro";
import DeterminismDemo from "./DeterminismDemo.astro";
import OrchestrationDemo from "./OrchestrationDemo.astro";
import dispatchCall from "./snippets/dispatch.ts?raw";
import fixTests from "./snippets/fix-tests.ts?raw";

const route = Astro.locals.starlightRoute;
const landing = route.entry.data.landing!;
const locale = route.locale === "fr" ? "fr/" : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) =>
  /^https?:/.test(path) ? path : `${base}/${locale}${path}`;
// The determinism bay shows the loop's check, cut from a typechecked file.
const fixLines = fixTests.split("\n");
const checkStart = fixLines.findIndex((line) => line.includes("async check("));
const checkEnd = fixLines.indexOf("  },", checkStart);
if (checkStart < 0 || checkEnd < 0)
  throw new Error("The fix-tests snippet no longer has a check block.");
const checkCode = fixLines
  .slice(checkStart, checkEnd + 1)
  .map((line) => line.slice(2))
  .join("\n");
const outcome = landing.install.outcome
  .split(/`([^`]+)`/)
  .map((part, index) => ({ part, code: index % 2 === 1 }));
const runtimeGroups = [
  { label: landing.runtimes.agentsLabel, items: landing.runtimes.agents },
  { label: landing.runtimes.sandboxesLabel, items: landing.runtimes.sandboxes },
];
---

<main class="landing" data-pagefind-body>
  <div class="rail">
    <section class="bay hero" aria-labelledby="_top">
      <div class="say hero-copy">
        <h1 id="_top">
          {landing.headline.map((clause) => <span>{clause}</span>)}
        </h1>
        <p class="lead">{landing.lead}</p>
        <p class="install-note">{landing.install.prerequisites}</p>
        <outpost-install class="install" data-copied={landing.install.copied}>
          <code><span aria-hidden="true">$ </span>{landing.install.command}</code
          >
          <button
            type="button"
            aria-label={landing.install.copy}
            title={landing.install.copy}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="copy-icon">
              <rect x="9" y="9" width="12" height="12" rx="1.5"></rect>
              <path
                d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"
              ></path>
            </svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="done-icon"
              ><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg
            >
          </button>
          <span class="status" role="status" aria-live="polite"></span>
        </outpost-install>
        <p class="install-note">
          {outcome.map(({ part, code }) => (code ? <code>{part}</code> : part))}
        </p>
        <p class="install-note install-next">
          <code>{landing.install.next}</code>
        </p>
        <div class="actions">
          <a class="button primary" href={href(landing.primary.href)}>
            {landing.primary.label}
            <Arrow />
          </a>
          <a class="button" href={href(landing.secondary.href)}
            >{landing.secondary.label}</a
          >
        </div>
        <p class="facts">
          {`${landing.facts} · v${manifest.version} · `}
          <a href={href(landing.reference.href)}>{landing.reference.label}</a>
        </p>
      </div>
      <div class="show hero-code">
        <figure class="excerpt hero-excerpt">
          <figcaption>{landing.hero.caption}</figcaption>
          <div
            class="excerpt-code"
            role="region"
            aria-label={landing.hero.caption}
            tabindex="0"
          >
            <Code code={dispatchCall.trimEnd()} lang="ts" />
          </div>
        </figure>
      </div>
      <ul class="hero-evidence">
        {landing.evidence.map((fact) => <li>{fact}</li>)}
      </ul>
    </section>

    <section class="bay" aria-labelledby="use-cases-title">
      <div class="say">
        <h2 id="use-cases-title">{landing.useCases.title}</h2>
        <p>{landing.useCases.text}</p>
        <a class="more" href={href(landing.useCases.link.href)}
          >{landing.useCases.link.label}<Arrow /></a
        >
      </div>
      <div class="show flush use-cases">
        {
          landing.useCases.entries.map((useCase) => (
            <a href={href(useCase.href)}>
              <strong>{useCase.title}</strong>
              <span>{useCase.text}</span>
              <Arrow />
            </a>
          ))
        }
      </div>
    </section>

    <section class="bay problem" aria-labelledby="problem-title">
      <div class="show figure-wide">
        <OrchestrationDemo demo={landing.demo} />
      </div>
      <div class="say">
        <h2 id="problem-title">{landing.problem.title}</h2>
        <p>{landing.problem.text}</p>
        <a class="more" href={href(landing.problem.link.href)}
          >{landing.problem.link.label}<Arrow /></a
        >
      </div>
      <div class="show flush pains">
        {
          landing.problem.groups.map((group) => (
            <div class="pain-group">
              <div class="pain-head">
                <h3>{group.title}</h3>
                <span aria-hidden="true">{landing.problem.answerLabel}</span>
              </div>
              <dl>
                {group.rows.map((row) => (
                  <div class="pain">
                    <dt>
                      <strong>{row.pain}</strong>
                      <span>{row.detail}</span>
                    </dt>
                    <dd>
                      <span class="sr-label">{landing.problem.answerLabel}: </span>
                      {row.answer}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bay" aria-labelledby="determinism-heading">
      <div class="say">
        <h2 id="determinism-heading">{landing.determinism.title}</h2>
        <p>{landing.determinism.text}</p>
        <figure class="excerpt">
          <figcaption>{landing.determinism.check}</figcaption>
          <div
            class="excerpt-code"
            role="region"
            aria-label={landing.determinism.check}
            tabindex="0"
          >
            <Code code={checkCode} lang="ts" />
          </div>
        </figure>
        <div class="links">
          <a class="more" href={href(landing.determinism.link.href)}
            >{landing.determinism.link.label}<Arrow /></a
          >
          <a class="more" href={href(landing.determinism.replayLink.href)}
            >{landing.determinism.replayLink.label}<Arrow /></a
          >
        </div>
      </div>
      <div class="show determinism-demo">
        <DeterminismDemo demo={landing.determinism.demo} />
      </div>
    </section>

    <section class="bay" aria-labelledby="runtimes-title">
      <div class="say">
        <h2 id="runtimes-title">{landing.runtimes.title}</h2>
        <p>{landing.runtimes.text}</p>
        <a class="more" href={href(landing.runtimes.link.href)}
          >{landing.runtimes.link.label}<Arrow /></a
        >
      </div>
      <div class="show flush runtimes">
        {
          runtimeGroups.map((group) => (
            <div class="runtime-group">
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={href(item.href)}>
                      {item.name}
                      {item.experimental && (
                        <span
                          class="flask"
                          role="img"
                          aria-label={landing.runtimes.experimental}
                          title={landing.runtimes.experimental}
                        />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bay" aria-labelledby="boundaries-title">
      <div class="say">
        <h2 id="boundaries-title">{landing.boundaries.title}</h2>
        <p>{landing.boundaries.text}</p>
        <div class="closing">
          <a
            class="button primary"
            href={href(landing.boundaries.action.href)}
          >
            {landing.boundaries.action.label}
            <Arrow />
          </a>
          <a class="more" href={href(landing.boundaries.link.href)}
            >{landing.boundaries.link.label}<Arrow /></a
          >
        </div>
      </div>
      <div class="show flush boundaries">
        <dl>
          {
            landing.boundaries.entries.map((boundary) => (
              <div class="boundary">
                <dt>{boundary.lead}</dt>
                <dd>{boundary.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <footer class="landing-footer">
      <div class="footer-brand">
        <Brand href={href("")} class="wordmark" />
        <p>{landing.tagline}</p>
      </div>
      {
        [landing.footer.documentation, landing.footer.source].map((column) => (
          <nav aria-label={column.title}>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={href(link.href)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <p class="footer-legal">{landing.footer.license} v{manifest.version}</p>
    </footer>
  </div>
</main>

<script>
  class OutpostInstall extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      const status = this.querySelector<HTMLElement>(".status");
      const command = this.querySelector("code")?.lastChild?.textContent ?? "";
      button?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(command.trim());
        button.dataset.done = "";
        if (status) status.textContent = this.dataset.copied ?? "";
        setTimeout(() => {
          delete button.dataset.done;
          if (status) status.textContent = "";
        }, 1600);
      });
    }
  }
  customElements.define("outpost-install", OutpostInstall);

  // A fade marks the edge where the excerpt still has code to scroll to.
  for (const scroller of document.querySelectorAll<HTMLElement>(
    ".excerpt-code",
  )) {
    const measure = () =>
      scroller.toggleAttribute(
        "data-clipped",
        scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 1,
      );
    scroller.addEventListener("scroll", measure, { passive: true });
    new ResizeObserver(measure).observe(scroller);
  }

</script>

<style>
  .landing {
    --landing-line: var(--sl-color-hairline-light);
    --landing-code-bg: color-mix(
      in oklch,
      var(--sl-color-gray-6) 45%,
      var(--sl-color-black)
    );
    --landing-code-bg-active: color-mix(
      in oklch,
      var(--sl-color-gray-6) 80%,
      var(--sl-color-black)
    );
    --landing-gutter: var(--sl-color-gray-3);
    --landing-pad: clamp(1.25rem, 3.2vw, 3rem);
    --landing-ease: cubic-bezier(0.16, 1, 0.3, 1);
    padding-top: 4rem;
    background-color: var(--sl-color-black);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent) 7px 8px
    );
    color: var(--sl-color-gray-2);
  }
  .rail {
    max-width: 82rem;
    margin: 0 auto;
    border-inline: 1px solid var(--landing-line);
    background: var(--sl-color-black);
  }
  .landing :where(h1, h2, h3, p, ul, ol, dl, dd, figure) {
    margin: 0;
  }
  .landing :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  .landing ::selection {
    background: color-mix(in oklch, var(--sl-color-accent) 32%, transparent);
    color: var(--sl-color-white);
  }
  .landing a {
    text-underline-offset: 0.22em;
  }
  .landing :focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* Every section splits at track 5 of 12; cells split the right bay at track 9. */
  .bay {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border-bottom: 1px solid var(--landing-line);
  }
  .say {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 3.5rem var(--landing-pad);
    border-right: 1px solid var(--landing-line);
  }
  .show {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 3rem var(--landing-pad);
  }
  .flush {
    padding: 0;
  }
  .figure-wide {
    grid-column: 1 / -1;
    padding-block: 2.75rem;
    border-bottom: 1px solid var(--landing-line);
  }
  .say > p {
    max-width: 34rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .say h2 {
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--sl-color-gray-4);
    transition: text-decoration-color 0.2s var(--landing-ease);
  }
  .more:hover {
    text-decoration-color: var(--sl-color-white);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-top: auto;
  }
  .links .more {
    margin-top: 0;
  }
  .excerpt {
    margin: 0.75rem 0 0;
    border: 1px solid var(--landing-line);
    background: var(--landing-code-bg);
  }
  .excerpt figcaption {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--landing-line);
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
  }
  .hero-excerpt {
    margin: 0;
  }
  .hero-excerpt .excerpt-code :global(pre) {
    font-size: 0.8125rem;
  }
  .excerpt-code[data-clipped] {
    mask-image: linear-gradient(
      to right,
      #000 calc(100% - 2.5rem),
      transparent
    );
  }
  .excerpt-code:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .excerpt-code {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-5) transparent;
  }
  .excerpt-code :global([data-celestia-code-container]) {
    overflow: visible;
    border: 0;
    border-radius: 0;
  }
  .excerpt-code :global(celestia-code-copy-button) {
    display: none;
  }
  .excerpt-code :global(pre) {
    margin: 0;
    padding: 0.85rem 1rem;
    overflow: visible !important;
    background: transparent !important;
    font-size: 0.75rem;
    line-height: 1.7;
  }

  /* Hero */
  .hero {
    min-height: min(calc(100svh - 4rem), 48rem);
  }
  .hero-copy {
    gap: 0;
    container-type: inline-size;
  }
  .hero-code {
    justify-content: flex-start;
    padding-block: 3.5rem;
  }
  h1 {
    color: var(--sl-color-white);
    font-size: clamp(2.2rem, 10.2cqi, 3.4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  h1 span {
    display: block;
    text-wrap: balance;
  }
  .lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .install-note {
    max-width: 34rem;
    margin-top: 1.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .install-note code {
    color: var(--sl-color-white);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .install-next {
    margin-top: 0.4rem;
  }
  .install-next code {
    white-space: normal;
  }
  .install {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 26rem;
    margin-top: 0.75rem;
    border: 1px solid var(--landing-line);
    background: var(--landing-code-bg);
  }
  .install code {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    color: var(--sl-color-white);
    background: none;
    border: 0;
    font-size: 0.875rem;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .install code span {
    color: var(--sl-color-gray-3);
  }
  .install button {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 2.9rem;
    border: 0;
    border-left: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .install button:hover,
  .install button[data-done] {
    color: var(--sl-color-white);
  }
  .install svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .done-icon,
  .install button[data-done] .copy-icon {
    display: none;
  }
  .install button[data-done] .done-icon {
    display: block;
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .install + .install-note {
    margin-top: 0.75rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.2s var(--landing-ease),
      border-color 0.2s var(--landing-ease);
  }
  .button:hover {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }
  .button.primary {
    border-color: var(--sl-color-white);
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .button.primary:hover {
    background: var(--sl-color-gray-1);
  }
  .facts {
    margin-top: 1.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .facts a {
    color: var(--sl-color-gray-2);
  }
  .facts a:hover {
    color: var(--sl-color-white);
  }
  .hero-evidence {
    display: flex;
    flex-wrap: wrap;
    grid-column: 1 / -1;
    gap: 0 0.5rem;
    padding: 0.9rem var(--landing-pad);
    border-top: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .hero-evidence li:not(:last-child)::after {
    margin-left: 0.5rem;
    color: var(--sl-color-gray-4);
    content: "\00b7";
  }

  /* Use cases are whole rows, so they add no vertical line to the frame. */
  .use-cases {
    justify-content: center;
  }
  .use-cases a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.35rem 1.25rem;
    padding: 1.4rem var(--landing-pad);
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    line-height: 1.55;
    text-decoration: none;
    transition: background-color 0.2s var(--landing-ease);
  }
  .use-cases a + a {
    border-top: 1px solid var(--landing-line);
  }
  .use-cases a:hover {
    background: var(--landing-code-bg);
  }
  .use-cases strong {
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .use-cases span {
    grid-column: 1;
    max-width: 34rem;
  }
  .use-cases :global(.arrow) {
    grid-row: 1;
    grid-column: 2;
    align-self: center;
    color: var(--sl-color-gray-3);
    transition:
      color 0.2s var(--landing-ease),
      transform 0.2s var(--landing-ease);
  }
  .use-cases a:hover :global(.arrow) {
    color: var(--sl-color-white);
  }

  /* Pains split the seven-track bay 4|3 so the answer column starts on track 9. */
  .pain-group + .pain-group {
    border-top: 1px solid var(--landing-line);
  }
  .pain-head,
  .pain {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr);
  }
  .pain-head {
    border-bottom: 1px solid var(--landing-line);
  }
  .pain-head > * {
    padding: 0.8rem var(--landing-pad);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .pain-head span,
  .pain dd {
    border-left: 1px solid var(--landing-line);
  }
  .pain + .pain {
    border-top: 1px solid var(--landing-line);
  }
  .pain dt,
  .pain dd {
    padding: 1.4rem var(--landing-pad);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .pain dt {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pain strong {
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pain dd {
    color: var(--sl-color-white);
  }
  .sr-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* Runtimes */
  .runtimes {
    justify-content: center;
  }
  .runtime-group + .runtime-group {
    border-top: 1px solid var(--landing-line);
  }
  .runtime-group h3 {
    padding: 0.8rem var(--landing-pad);
    border-bottom: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .runtime-group ul {
