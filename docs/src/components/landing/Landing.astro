---
import { render } from "astro:content";
import manifest from "../../../../package.json";
import { iconForHref, iconMarkup } from "../../../scripts/guide-icons.mjs";
import Brand from "../Brand.astro";
import Arrow from "./Arrow.astro";
import InstallCommand from "./InstallCommand.astro";

const route = Astro.locals.starlightRoute;
const landing = route.entry.data.landing!;
const { Content } = await render(route.entry);
const locale = route.locale === "fr" ? "fr/" : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) =>
  /^https?:/.test(path) ? path : `${base}/${locale}${path}`;
---

<main class="landing" data-pagefind-body>
  <div class="rail">
    <section class="hero" aria-labelledby="_top">
      <div class="hero-copy">
        <p class="category">{landing.category}</p>
        <h1 id="_top">
          {landing.headline.map((line) => <span>{line}</span>)}
        </h1>
        <p class="lead">{landing.lead}</p>
        <div class="actions">
          <a class="button primary" href={href(landing.primary.href)}>
            {landing.primary.label}<Arrow />
          </a>
          <a class="button" href={href(landing.secondary.href)}>
            {landing.secondary.label}<Arrow />
          </a>
        </div>
        <InstallCommand install={landing.install} />
        <p class="prerequisites">{landing.install.prerequisites}</p>
      </div>
      <ul class="overview">
        {
          landing.overview.map((entry) => (
          <li>
            <a href={href(entry.href)}>
              <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
                set:html={iconMarkup(iconForHref(entry.href))}
              />
              <span class="overview-copy">
                <strong>{entry.title}</strong><span>{entry.text}</span>
              </span>
              <Arrow />
            </a>
          </li>
          ))
        }
      </ul>
    </section>

    <div class="home-content sl-markdown-content">
      <Content />
    </div>

    <section class="next" aria-labelledby="next-title">
      <div>
        <h2 id="next-title">{landing.next.title}</h2>
        <p>{landing.next.text}</p>
      </div>
      <div class="next-actions">
        {
          [landing.next.guide, landing.next.reference].map((link) => (
            <a href={href(link.href)}>{link.label}<Arrow /></a>
          ))
        }
      </div>
    </section>

    <footer class="landing-footer">
      <div class="footer-brand">
        <Brand href={`${base}/${locale}`} />
        <p>{landing.footer.license} · v{manifest.version}</p>
      </div>
      {
        [landing.footer.documentation, landing.footer.source].map((column) => (
          <nav aria-label={column.title}>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li><a href={href(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
        ))
      }
    </footer>
  </div>
</main>

<style>
  .landing {
    padding-top: 4rem;
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent) 7px 8px
    );
  }
  .rail {
    container-type: inline-size;
    max-width: 90rem;
    margin-inline: auto;
    background: var(--sl-color-black);
    border-inline: 1px solid var(--docs-line);
  }
  .landing :where(h1, h2, p, ul) {
    margin: 0;
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    border-bottom: 1px solid var(--docs-line);
  }
  .hero-copy {
    min-width: 0;
    padding: clamp(2rem, 4vw, 4rem) var(--docs-pad);
  }
  .category {
    margin-bottom: 1.1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  h1 {
    max-width: 21ch;
    color: var(--sl-color-white);
    font-size: clamp(2.35rem, 4.6vw, 4.3rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  h1 span {
    display: block;
  }
  .lead {
    max-width: 53ch;
    margin-top: 1.5rem;
    color: var(--sl-color-gray-2);
    font-size: 1.1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 2.9rem;
    padding: 0.6rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .button:hover {
    background: var(--sl-color-gray-6);
  }
  .button.primary {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .button.primary:hover {
    background: var(--sl-color-gray-2);
  }
  .prerequisites {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .overview {
    display: grid;
    grid-template-rows: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    border-left: 1px solid var(--docs-line);
  }
  .overview li + li {
    border-top: 1px solid var(--docs-line);
  }
  .overview a {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 9rem;
    height: 100%;
    padding: 1.75rem var(--docs-pad);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .overview a:hover {
    background: var(--docs-code-bg);
  }
  .overview svg {
    flex-shrink: 0;
  }
  .overview-copy {
    display: grid;
    flex: 1;
    gap: 0.5rem;
  }
  .overview strong {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .overview-copy > span {
    max-width: 30ch;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .home-content {
    font-size: 1.0714rem;
    line-height: 1.75;
  }
  .home-content :global(> .bay) {
    margin: 0;
    border-bottom: 1px solid var(--docs-line);
  }
  .next > div:first-child {
    padding: 2.5rem var(--docs-pad);
  }
  .next h2 {
    color: var(--sl-color-white);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }
  .next p {
    margin-top: 0.85rem;
    color: var(--sl-color-gray-2);
    font-size: 1.0714rem;
    line-height: 1.65;
  }
  .next-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--docs-line);
  }
  .next-actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 1.5rem var(--docs-pad);
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }
  .next-actions a + a {
    border-left: 1px solid var(--docs-line);
  }
  .next-actions a:hover {
    background: var(--docs-code-bg);
  }
  .landing-footer {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
  }
  .landing-footer > * {
    min-width: 0;
    padding: 2rem var(--docs-pad);
  }
  .footer-brand p {
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .landing-footer h2 {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .landing-footer ul {
    padding: 0;
    margin-top: 1rem;
    list-style: none;
  }
  .landing-footer li + li {
    margin-top: 0.65rem;
  }
  .landing-footer nav a {
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .landing-footer nav a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (max-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .overview {
      display: grid;
      grid-template-rows: none;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-left: 0;
      border-top: 1px solid var(--docs-line);
    }
    .overview li + li {
      border-top: 0;
      border-left: 1px solid var(--docs-line);
    }
    .overview a {
      align-items: flex-start;
      flex-wrap: wrap;
      gap: 1rem;
      height: 100%;
      min-height: 0;
      padding: 1.5rem var(--docs-pad);
    }
    .overview-copy {
      flex-basis: 100%;
      order: 1;
    }
    .overview a :global(.arrow) {
      margin-left: auto;
    }
    h1 {
      max-width: 28ch;
      font-size: clamp(2.35rem, 5.6vw, 4.3rem);
    }
  }
  @media (max-width: 40rem) {
    .rail {
      border-inline: 0;
    }
    .hero-copy {
      padding-top: 2.25rem;
      padding-bottom: 2rem;
    }
    .lead {
      font-size: 1rem;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .overview {
      display: block;
    }
    .overview li + li {
      border-left: 0;
      border-top: 1px solid var(--docs-line);
    }
    .overview a {
      flex-wrap: nowrap;
      align-items: center;
      padding-block: 1.25rem;
    }
    .overview-copy {
      flex-basis: auto;
      order: 0;
    }
    .overview strong {
      font-size: 1.0625rem;
    }
    .overview-copy > span {
      font-size: 0.9375rem;
    }
    .actions .button {
      flex: 1;
    }
    .landing-footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
      border-bottom: 1px solid var(--docs-line);
    }
    .next-actions a {
      padding: 1.25rem var(--docs-pad);
      align-items: flex-start;
      font-size: 0.9375rem;
    }
  }
</style>
