---
import manifest from "../../../../package.json";
import Brand from "../Brand.astro";
import Arrow from "./Arrow.astro";
import CodeWindow from "./CodeWindow.astro";
import OrchestrationDemo from "./OrchestrationDemo.astro";
import pipeline from "./snippets/pipeline.ts?raw";

const route = Astro.locals.starlightRoute;
const landing = route.entry.data.landing!;
const locale = route.locale === "fr" ? "fr/" : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) =>
  /^https?:/.test(path) ? path : `${base}/${locale}${path}`;
const pipelineLines = pipeline.split("\n");
for (const step of landing.workflow.steps) {
  const [first = 0] = step.lines.split("-").map(Number);
  if (!pipelineLines[first - 1]?.startsWith("const "))
    throw new Error(
      `Workflow step "${step.title}" does not start at a declaration.`,
    );
}
const runtimeGroups = [
  { label: landing.runtimes.agentsLabel, items: landing.runtimes.agents },
  { label: landing.runtimes.sandboxesLabel, items: landing.runtimes.sandboxes },
];
---

<main class="landing" data-pagefind-body>
  <div class="rail">
    <section class="bay hero" aria-labelledby="_top">
      <div class="say hero-copy">
        <h1 id="_top">
          {landing.headline.map((clause) => <span>{clause}</span>)}
        </h1>
        <p class="lead">{landing.lead}</p>
        <outpost-install class="install" data-copied={landing.install.copied}>
          <code><span aria-hidden="true">$ </span>{landing.install.command}</code
          >
          <button
            type="button"
            aria-label={landing.install.copy}
            title={landing.install.copy}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="copy-icon">
              <rect x="9" y="9" width="12" height="12" rx="1.5"></rect>
              <path
                d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"
              ></path>
            </svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="done-icon"
              ><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg
            >
          </button>
          <span class="status" role="status" aria-live="polite"></span>
        </outpost-install>
        <div class="actions">
          <a class="button primary" href={href(landing.primary.href)}>
            {landing.primary.label}
            <Arrow />
          </a>
          <a class="button" href={href(landing.secondary.href)}
            >{landing.secondary.label}</a
          >
        </div>
        <p class="facts">
          {`${landing.facts} · v${manifest.version} · `}
          <a href={href(landing.reference.href)}>{landing.reference.label}</a>
        </p>
      </div>
      <div class="show hero-demo">
        <OrchestrationDemo demo={landing.demo} />
      </div>
    </section>

    <section class="bay" aria-labelledby="problem-title">
      <div class="say">
        <h2 id="problem-title">{landing.problem.title}</h2>
        <p>{landing.problem.text}</p>
        <a class="more" href={href(landing.problem.link.href)}
          >{landing.problem.link.label}<Arrow /></a
        >
      </div>
      <div class="show flush pains">
        {
          landing.problem.groups.map((group) => (
            <div class="pain-group">
              <div class="pain-head">
                <h3>{group.title}</h3>
                <span aria-hidden="true">{landing.problem.answerLabel}</span>
              </div>
              <dl>
                {group.rows.map((row) => (
                  <div class="pain">
                    <dt>
                      <strong>{row.pain}</strong>
                      <span>{row.detail}</span>
                    </dt>
                    <dd>
                      <span class="sr-label">{landing.problem.answerLabel}: </span>
                      {row.answer}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </section>

    <section
      class="bay workflow"
      aria-labelledby="workflow-title"
      data-workflow
    >
      <div class="say flush">
        <div class="workflow-intro">
          <h2 id="workflow-title">{landing.workflow.title}</h2>
          <p>{landing.workflow.text}</p>
        </div>
        <ol class="steps" aria-label={landing.workflow.stepsLabel}>
          {
            landing.workflow.steps.map((step, index) => (
              <li>
                <button
                  type="button"
                  data-lines={step.lines}
                  aria-pressed={index === 0 ? "true" : "false"}
                  aria-controls="workflow-files-panel-0"
                >
                  <span class="step-number">{index + 1}</span>
                  <span class="step-copy">
                    <strong>{step.title}</strong>
                    <span>{step.text}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ol>
        <a class="more" href={href(landing.workflow.link.href)}
          >{landing.workflow.link.label}<Arrow /></a
        >
      </div>
      <div class="show workflow-code">
        <CodeWindow
          id="workflow-files"
          label={landing.workflow.title}
          copyLabel={landing.workflow.copy}
          copiedLabel={landing.install.copied}
          files={[{ name: "pipeline.ts", code: pipeline, lang: "ts" }]}
          scroll
        />
      </div>
    </section>

    <section class="bay" aria-labelledby="runtimes-title">
      <div class="say">
        <h2 id="runtimes-title">{landing.runtimes.title}</h2>
        <p>{landing.runtimes.text}</p>
        <a class="more" href={href(landing.runtimes.link.href)}
          >{landing.runtimes.link.label}<Arrow /></a
        >
      </div>
      <div class="show flush runtimes">
        {
          runtimeGroups.map((group) => (
            <div class="runtime-group">
              <h3>{group.label}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>
                    <a href={href(item.href)}>
                      {item.name}
                      {item.experimental && (
                        <span
                          class="flask"
                          role="img"
                          aria-label={landing.runtimes.experimental}
                          title={landing.runtimes.experimental}
                        />
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <footer class="landing-footer">
      <div class="footer-brand">
        <Brand href={href("")} class="wordmark" />
        <p>{landing.tagline}</p>
      </div>
      {
        [landing.footer.documentation, landing.footer.source].map((column) => (
          <nav aria-label={column.title}>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={href(link.href)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
      <p class="footer-legal">{landing.footer.license} v{manifest.version}</p>
    </footer>
  </div>
</main>

<script>
  class OutpostInstall extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      const status = this.querySelector<HTMLElement>(".status");
      const command = this.querySelector("code")?.lastChild?.textContent ?? "";
      button?.addEventListener("click", async () => {
        await navigator.clipboard.writeText(command.trim());
        button.dataset.done = "";
        if (status) status.textContent = this.dataset.copied ?? "";
        setTimeout(() => {
          delete button.dataset.done;
          if (status) status.textContent = "";
        }, 1600);
      });
    }
  }
  customElements.define("outpost-install", OutpostInstall);

  const section = document.querySelector<HTMLElement>("[data-workflow]");
  const steps = [
    ...(section?.querySelectorAll<HTMLButtonElement>("[data-lines]") ?? []),
  ];
  const scroller = section?.querySelector<HTMLElement>(".workflow-code .code");
  const lines = [...(scroller?.querySelectorAll<HTMLElement>(".line") ?? [])];
  const highlight = (step: HTMLButtonElement | undefined, reveal = true) => {
    const [first = 0, last = first] = (step?.dataset.lines ?? "")
      .split("-")
      .map(Number);
    lines.forEach((line, index) => {
      line.toggleAttribute(
        "data-active",
        index + 1 >= first && index + 1 <= last,
      );
    });
    const target = lines[first - 1];
    if (!reveal || !scroller || !target) return;
    const offset =
      target.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
    scroller.scrollTo({ top: scroller.scrollTop + offset - 24 });
  };
  const pinned = () =>
    steps.find((step) => step.getAttribute("aria-pressed") === "true");
  for (const step of steps) {
    step.addEventListener("click", () => {
      const active = step.getAttribute("aria-pressed") === "true";
      steps.forEach((other) =>
        other.setAttribute("aria-pressed", String(other === step && !active)),
      );
      highlight(pinned());
    });
    step.addEventListener("pointerenter", () => highlight(step));
    step.addEventListener("pointerleave", () => highlight(pinned()));
    step.addEventListener("focus", () => highlight(step));
    step.addEventListener("blur", () => highlight(pinned()));
  }
  highlight(pinned(), false);
</script>

<style>
  .landing {
    --landing-line: var(--sl-color-hairline-light);
    --landing-code-bg: color-mix(
      in oklch,
      var(--sl-color-gray-6) 45%,
      var(--sl-color-black)
    );
    --landing-code-bg-active: color-mix(
      in oklch,
      var(--sl-color-gray-6) 80%,
      var(--sl-color-black)
    );
    --landing-gutter: var(--sl-color-gray-3);
    --landing-pad: clamp(1.25rem, 3.2vw, 3rem);
    --landing-ease: cubic-bezier(0.16, 1, 0.3, 1);
    padding-top: 4rem;
    background-color: var(--sl-color-black);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent) 7px 8px
    );
    color: var(--sl-color-gray-2);
  }
  .rail {
    max-width: 82rem;
    margin: 0 auto;
    border-inline: 1px solid var(--landing-line);
    background: var(--sl-color-black);
  }
  .landing :where(h1, h2, h3, p, ul, ol, dl, dd, figure) {
    margin: 0;
  }
  .landing :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  .landing ::selection {
    background: color-mix(in oklch, var(--sl-color-accent) 32%, transparent);
    color: var(--sl-color-white);
  }
  .landing a {
    text-underline-offset: 0.22em;
  }
  .landing :focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  /* Every section splits at track 5 of 12; cells split the right bay at track 9. */
  .bay {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border-bottom: 1px solid var(--landing-line);
  }
  .say {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 3.5rem var(--landing-pad);
    border-right: 1px solid var(--landing-line);
  }
  .show {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 3rem var(--landing-pad);
  }
  .flush {
    padding: 0;
  }
  .say > p,
  .workflow-intro > p {
    max-width: 34rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .say h2 {
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 2.2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--sl-color-gray-4);
    transition: text-decoration-color 0.2s var(--landing-ease);
  }
  .more:hover {
    text-decoration-color: var(--sl-color-white);
  }

  /* Hero */
  .hero {
    min-height: min(calc(100svh - 4rem), 48rem);
  }
  .hero-copy {
    justify-content: center;
    gap: 0;
    container-type: inline-size;
  }
  h1 {
    color: var(--sl-color-white);
    font-size: clamp(2.2rem, 10.2cqi, 3.4rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  h1 span {
    display: block;
  }
  .lead {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .install {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 26rem;
    margin-top: 2rem;
    border: 1px solid var(--landing-line);
    background: var(--landing-code-bg);
  }
  .install code {
    flex: 1;
    min-width: 0;
    padding: 0.8rem 1rem;
    overflow-x: auto;
    color: var(--sl-color-white);
    background: none;
    border: 0;
    font-size: 0.875rem;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .install code span {
    color: var(--sl-color-gray-3);
  }
  .install button {
    display: grid;
    place-items: center;
    align-self: stretch;
    width: 2.9rem;
    border: 0;
    border-left: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .install button:hover,
  .install button[data-done] {
    color: var(--sl-color-white);
  }
  .install svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .done-icon,
  .install button[data-done] .copy-icon {
    display: none;
  }
  .install button[data-done] .done-icon {
    display: block;
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.2s var(--landing-ease),
      border-color 0.2s var(--landing-ease);
  }
  .button:hover {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }
  .button.primary {
    border-color: var(--sl-color-white);
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .button.primary:hover {
    background: var(--sl-color-gray-1);
  }
  .facts {
    margin-top: 1.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .facts a {
    color: var(--sl-color-gray-2);
  }
  .facts a:hover {
    color: var(--sl-color-white);
  }

  /* Pains split the seven-track bay 4|3 so the answer column starts on track 9. */
  .pain-group + .pain-group {
    border-top: 1px solid var(--landing-line);
  }
  .pain-head,
  .pain {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 3fr);
  }
  .pain-head {
    border-bottom: 1px solid var(--landing-line);
  }
  .pain-head > * {
    padding: 0.8rem var(--landing-pad);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .pain-head span,
  .pain dd {
    border-left: 1px solid var(--landing-line);
  }
  .pain + .pain {
    border-top: 1px solid var(--landing-line);
  }
  .pain dt,
  .pain dd {
    padding: 1.4rem var(--landing-pad);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .pain dt {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pain strong {
    color: var(--sl-color-white);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .pain dd {
    color: var(--sl-color-white);
  }
  .sr-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* Runtimes */
  .runtimes {
    justify-content: center;
  }
  .runtime-group + .runtime-group {
    border-top: 1px solid var(--landing-line);
  }
  .runtime-group h3 {
    padding: 0.8rem var(--landing-pad);
    border-bottom: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .runtime-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 1.25rem var(--landing-pad) 1.4rem;
  }
  .runtime-group a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    padding: 0 0.8rem;
    border: 1px solid var(--landing-line);
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color 0.2s var(--landing-ease),
      border-color 0.2s var(--landing-ease);
  }
  .runtime-group a:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--landing-code-bg);
  }
  .flask {
    width: 0.9rem;
    height: 0.9rem;
    background-color: var(--sl-color-accent);
    mask: url("../../assets/reference-experiment.svg") center / contain
      no-repeat;
  }

  /* Workflow */
  .workflow-intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 3.5rem var(--landing-pad) 2.5rem;
  }
  .steps {
    border-top: 1px solid var(--landing-line);
  }
  .steps li {
    border-bottom: 1px solid var(--landing-line);
  }
  .steps button {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
    padding: 1.35rem var(--landing-pad);
    border: 0;
    background: none;
    color: var(--sl-color-gray-2);
    font: inherit;
    text-align: start;
    cursor: pointer;
    transition: background-color 0.2s var(--landing-ease);
  }
  .steps button:hover,
  .steps button[aria-pressed="true"] {
    background: var(--landing-code-bg);
  }
  .steps button:focus-visible {
    outline-offset: -2px;
  }
  .step-number {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    transition:
      border-color 0.2s var(--landing-ease),
      background-color 0.2s var(--landing-ease),
      color 0.2s var(--landing-ease);
  }
  .steps button[aria-pressed="true"] .step-number {
    border-color: var(--sl-color-white);
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .step-copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .step-copy strong {
    color: var(--sl-color-white);
    font-weight: 500;
  }
  .step-copy span {
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .workflow .say > .more {
    padding: 1.5rem var(--landing-pad) 2.5rem;
  }
  .workflow-code {
    position: relative;
  }
  .workflow-code :global(.window) {
    position: absolute;
    inset: 3.5rem var(--landing-pad);
  }

  /* Footer columns start on tracks 5 and 9. */
  .landing-footer {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
  }
  .landing-footer > * {
    padding: 3rem var(--landing-pad) 2.5rem;
  }
  .footer-brand p:last-child {
    max-width: 22rem;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  .landing-footer h2 {
    margin-bottom: 0.9rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .landing-footer li + li {
    margin-top: 0.55rem;
  }
  .landing-footer nav a {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .landing-footer nav a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .landing-footer .footer-legal {
    grid-column: 1 / -1;
    padding-block: 1.25rem;
    border-top: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }

  @media (max-width: 64rem) {
    .bay {
      grid-template-columns: minmax(0, 1fr);
    }
    .hero {
      min-height: 0;
    }
    .say {
      padding-block: 3rem 2rem;
      border-right: 0;
    }
    .hero-copy {
      padding-block: 3.5rem 3rem;
      border-bottom: 1px solid var(--landing-line);
    }
    .show {
      padding-block: 0 3rem;
    }
    .hero-demo,
    .workflow-code {
      padding-block: 2rem;
    }
    .workflow-code :global(.window) {
      position: static;
    }
    .show.flush {
      border-top: 1px solid var(--landing-line);
    }
    .workflow .say {
      padding: 0;
    }
  }
  @media (max-width: 40rem) {
    .rail {
      border-inline: 0;
    }
    .pain-head,
    .pain {
      grid-template-columns: minmax(0, 1fr);
    }
    .pain-head {
      background: var(--landing-code-bg);
    }
    .pain-head h3 {
      color: var(--sl-color-white);
      font-size: 0.9375rem;
