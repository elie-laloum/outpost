---
import { render } from "astro:content";
import manifest from "../../../../package.json";
import Brand from "../Brand.astro";
import Arrow from "./Arrow.astro";
import InstallCommand from "./InstallCommand.astro";
import LandingIcon from "./LandingIcon.astro";
import ScenarioExplorer from "./ScenarioExplorer.astro";

const route = Astro.locals.starlightRoute;
const landing = route.entry.data.landing!;
const { Content } = await render(route.entry);
const locale = route.locale === "fr" ? "fr/" : "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const href = (path: string) =>
  /^(https?:|#)/.test(path) ? path : `${base}/${locale}${path}`;
---

<main class="landing" data-pagefind-body>
  <div class="rail">
    <section class="hero" aria-labelledby="_top">
      <div class="hero-copy">
        <p class="category">{landing.category}</p>
        <h1 id="_top">{landing.headline.map((line) => <span>{line}</span>)}</h1>
        <p class="lead">{landing.lead}</p>
        <div class="actions">
          <a class="button primary" href={href(landing.primary.href)}>{landing.primary.label}<Arrow /></a>
          <a class="button" href={href(landing.secondary.href)}>{landing.secondary.label}<Arrow /></a>
        </div>
      </div>
    </section>
    <ScenarioExplorer scenarios={landing.scenarios} />
    <ul class="overview">
      {landing.overview.map((entry) => (
        <li><LandingIcon name={entry.icon} /><div><h2>{entry.title}</h2><p>{entry.text}</p></div></li>
      ))}
    </ul>
    <div class="home-content sl-markdown-content"><Content /></div>
    <section class="capabilities" aria-labelledby="capabilities-title">
      <div class="capabilities-heading">
        <h2 id="capabilities-title">{landing.capabilities.title}</h2>
        <p>{landing.capabilities.text}</p>
      </div>
      <ul class="capability-grid">
        {landing.capabilities.items.map((entry) => (
          <li class="capability"><LandingIcon name={entry.icon} /><h3>{entry.title}</h3><p>{entry.text}</p></li>
        ))}
      </ul>
    </section>
    <section class="start" aria-labelledby="start-title">
      <div>
        <h2 id="start-title">{landing.closing.title}</h2>
        <p>{landing.closing.text}</p>
        <a class="button primary" href={href(landing.closing.link.href)}>{landing.closing.link.label}<Arrow /></a>
      </div>
      <div class="installation">
        <InstallCommand install={landing.install} />
        <p class="prerequisites">{landing.install.prerequisites}</p>
      </div>
    </section>
    <footer class="landing-footer">
      <div class="footer-brand">
        <Brand href={`${base}/${locale}`} />
        <p>{landing.footer.license} · v{manifest.version}</p>
      </div>
      {
        [landing.footer.documentation, landing.footer.source].map((column) => (
          <nav aria-label={column.title}>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li><a href={href(link.href)}>{link.label}</a></li>
              ))}
            </ul>
          </nav>
        ))
      }
    </footer>
  </div>
</main>

<style>
  .landing {
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent) 7px 8px
    );
  }
  .rail {
    container-type: inline-size;
    max-width: var(--docs-landing-width);
    margin-inline: auto;
    background: var(--sl-color-black);
    border-inline: 1px solid var(--docs-line);
  }
  .landing :where(h1, h2, p, ul) {
    margin: 0;
  }
  .hero {
    padding-top: var(--sl-nav-height);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(3rem, 6vw, 6rem) var(--docs-pad);
    text-align: center;
    background-image: radial-gradient(
      circle,
      var(--docs-line) 1px,
      transparent 1px
    );
    background-size: 24px 24px;
  }
  .category {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  h1 {
    margin-top: 1.5rem !important;
    max-width: 24ch;
    color: var(--sl-color-white);
    font-size: clamp(2.6rem, 5.7vw, 5.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  h1 span {
    display: block;
  }
  h1 span + span {
    color: var(--sl-color-gray-3);
  }
  .lead {
    max-width: 63ch;
    margin-top: 1.5rem !important;
    color: var(--sl-color-gray-2);
    font-size: 1.2rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 3.2rem;
    padding: 0.7rem 1.3rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
  }
  .button:hover {
    background: var(--sl-color-gray-6);
  }
  .button.primary {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .button.primary:hover {
    background: var(--sl-color-gray-2);
  }
  .overview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    padding: 0;
    border-block: 1px solid var(--docs-line);
  }
  .overview li {
    padding: 2rem var(--docs-pad);
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .overview li + li {
    border-left: 1px solid var(--docs-line);
  }
  .overview :global(svg) {
    flex-shrink: 0;
    color: var(--sl-color-accent);
  }
  .overview h2 {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--sl-color-white);
  }
  .overview p {
    margin-top: 0.6rem;
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .home-content {
    font-size: 1.0714rem;
    line-height: 1.75;
  }
  .home-content :global(> .bay) {
    margin: 0;
    border-bottom: 1px solid var(--docs-line);
  }
  .capabilities {
    background: var(--docs-code-bg);
    border-bottom: 1px solid var(--docs-line);
  }
  .capabilities-heading {
    padding: 3rem var(--docs-pad);
  }
  .capabilities-heading h2,
  .start h2 {
    color: var(--sl-color-white);
    font-size: clamp(1.8rem, 3vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .capabilities-heading p,
  .start p {
    max-width: 65ch;
    margin-top: 1rem;
    color: var(--sl-color-gray-2);
    font-size: 1.0714rem;
    line-height: 1.65;
  }
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--docs-line);
  }
  .capability {
    min-width: 0;
    border-right: 1px solid var(--docs-line);
    padding: 2rem var(--docs-pad);
  }
  .capability:nth-child(3n) {
    border-right: 0;
  }
  .capability:nth-child(n + 4) {
    border-top: 1px solid var(--docs-line);
  }
  .capability :global(svg) {
    color: var(--sl-color-accent);
  }
  .capability h3 {
    margin: 1rem 0;
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }
  .capability p {
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
  .start {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    padding: 3rem var(--docs-pad);
    border-bottom: 1px solid var(--docs-line);
  }
  .start .button {
    margin-top: 1.5rem;
  }
  .installation {
    min-width: 0;
  }
  .start .prerequisites {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }
  .landing-footer {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr);
  }
  .landing-footer > * {
    min-width: 0;
    padding: 2rem var(--docs-pad);
  }
  .footer-brand p {
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .landing-footer h2 {
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .landing-footer ul {
    padding: 0;
    margin-top: 1rem;
    list-style: none;
  }
  .landing-footer li + li {
    margin-top: 0.65rem;
  }
  .landing-footer nav a {
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .landing-footer nav a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .landing a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 3px;
  }
  @media (max-width: 64rem) {
    .overview li {
      flex-direction: column;
    }
  }
  @media (min-width: 40.001rem) and (max-width: 64rem) {
    .capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .capability:nth-child(n) {
      border-right: 1px solid var(--docs-line);
      border-top: 0;
    }
    .capability:nth-child(2n) {
      border-right: 0;
    }
    .capability:nth-child(n + 3) {
      border-top: 1px solid var(--docs-line);
    }
  }
  @media (max-width: 40rem) {
    .rail {
      border-inline: 0;
    }
    .lead {
      font-size: 1.05rem;
    }
    .actions {
      flex-direction: column;
      align-self: stretch;
    }
    .overview,
    .start {
      display: block;
    }
    .overview li {
      flex-direction: row;
    }
    .overview li + li {
      border-left: 0;
      border-top: 1px solid var(--docs-line);
    }
    .landing-footer {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer-brand {
      grid-column: 1 / -1;
      border-bottom: 1px solid var(--docs-line);
    }
    .capability-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .capability {
      border-right: 0;
    }
    .capability + .capability {
      border-top: 1px solid var(--docs-line);
    }
    .installation {
      margin-top: 2rem;
    }
  }
</style>
