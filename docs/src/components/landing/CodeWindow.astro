---
import Code from "starlight-theme-celestia/components/Code.astro";
import type { CodeWindowFile } from "./landing.types.ts";

interface Props {
  id: string;
  label: string;
  copyLabel: string;
  copiedLabel: string;
  exampleLabel?: string;
  files: CodeWindowFile[];
  scroll?: boolean;
}

const { id, label, copyLabel, copiedLabel, exampleLabel, files, scroll } =
  Astro.props;
const tabbed = files.length > 1;
---

<outpost-code-window
  class:list={["window", { scroll }]}
  data-copied={copiedLabel}
>
  <div class="bar">
    {
      tabbed ? (
        <div class="tabs" role="tablist" aria-label={label}>
          {files.map((file, index) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${index}`}
              aria-controls={`${id}-panel-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? 0 : -1}
            >
              {file.name}
              {file.example && exampleLabel && (
                <span class="example">{exampleLabel}</span>
              )}
            </button>
          ))}
        </div>
      ) : (
        <p class="title">{files[0]?.name}</p>
      )
    }
    <button
      type="button"
      class="copy"
      data-copy-panel
      aria-label={copyLabel}
      title={copyLabel}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" class="copy-icon">
        <rect x="9" y="9" width="12" height="12" rx="1.5"></rect>
        <path
          d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"
        ></path>
      </svg>
      <svg viewBox="0 0 24 24" aria-hidden="true" class="done-icon">
        <path d="m5 12.5 4.5 4.5L19 7.5"></path>
      </svg>
    </button>
  </div>
  {
    files.map((file, index) => (
      <div
        class="panel"
        id={`${id}-panel-${index}`}
        role={tabbed ? "tabpanel" : undefined}
        aria-labelledby={tabbed ? `${id}-tab-${index}` : undefined}
        hidden={index !== 0}
        data-lang={file.lang}
      >
        <div class="code">
          <Code code={file.code.trimEnd()} lang={file.lang} />
        </div>
        {file.note && (
          <p class:list={["note", { command: file.command }]}>
            {file.command && <span aria-hidden="true">$ </span>}
            {file.note}
          </p>
        )}
      </div>
    ))
  }
  <span class="status" role="status" aria-live="polite"></span>
</outpost-code-window>

<script>
  class OutpostCodeWindow extends HTMLElement {
    connectedCallback() {
      const tabs = [
        ...this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const panels = [...this.querySelectorAll<HTMLElement>(".panel")];
      const scrollers = [...this.querySelectorAll<HTMLElement>(".code")];
      const measure = () => {
        for (const scroller of scrollers) {
          const fade = (edge: string, clipped: boolean) =>
            scroller.style.setProperty(`--fade-${edge}`, clipped ? "2.5rem" : "0px");
          fade("right", scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 1);
          fade("top", scroller.scrollTop > 1);
          fade("bottom", scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1);
        }
      };
      const select = (index: number) => {
        tabs.forEach((tab, position) => {
          tab.setAttribute("aria-selected", String(position === index));
          tab.tabIndex = position === index ? 0 : -1;
        });
        panels.forEach((panel, position) => {
          panel.hidden = position !== index;
        });
        measure();
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          const destinations: Record<string, number> = {
            ArrowLeft: (index - 1 + tabs.length) % tabs.length,
            ArrowRight: (index + 1) % tabs.length,
            Home: 0,
            End: tabs.length - 1,
          };
          const destination = destinations[event.key];
          if (destination === undefined) return;
          event.preventDefault();
          select(destination);
          tabs[destination]?.focus();
        });
      });
      for (const scroller of scrollers)
        scroller.addEventListener("scroll", measure, { passive: true });
      new ResizeObserver(measure).observe(this);
      const copy = this.querySelector<HTMLButtonElement>("[data-copy-panel]");
      const status = this.querySelector<HTMLElement>(".status");
      copy?.addEventListener("click", async () => {
        const code = panels
          .find((panel) => !panel.hidden)
          ?.querySelector("code");
        if (!code?.textContent) return;
        await navigator.clipboard.writeText(code.textContent);
        copy.dataset.done = "";
        if (status) status.textContent = this.dataset.copied ?? "";
        setTimeout(() => {
          delete copy.dataset.done;
          if (status) status.textContent = "";
        }, 1600);
      });
    }
  }
  customElements.define("outpost-code-window", OutpostCodeWindow);
</script>

<style>
  .window {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--landing-line);
    background: var(--landing-code-bg);
  }
  .bar {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--landing-line);
  }
  .tabs {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
  }
  [role="tab"],
  .title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0 1rem;
    border: 0;
    border-right: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    font: 400 0.8125rem / 1 var(--sl-font-system-mono);
    white-space: nowrap;
    cursor: pointer;
  }
  .title {
    color: var(--sl-color-white);
    cursor: default;
  }
  [role="tab"]:hover {
    color: var(--sl-color-white);
  }
  .tabs [role="tab"] {
    box-shadow: none !important;
  }
  .tabs [role="tab"][aria-selected="true"] {
    color: var(--sl-color-white);
    background: var(--landing-code-bg-active);
    box-shadow: inset 0 -2px 0 var(--sl-color-white) !important;
  }
  .example {
    padding: 0.2rem 0.35rem;
    border: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font: 500 0.625rem / 1 var(--sl-font);
    letter-spacing: 0.02em;
  }
  .copy {
    display: grid;
    place-items: center;
    width: 2.75rem;
    flex: 0 0 2.75rem;
    border: 0;
    border-left: 1px solid var(--landing-line);
    background: none;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .copy:hover,
  .copy[data-done] {
    color: var(--sl-color-white);
  }
  .copy svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .done-icon,
  .copy[data-done] .copy-icon {
    display: none;
  }
  .copy[data-done] .done-icon {
    display: block;
  }
  .panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
  }
  .panel[hidden] {
    display: none;
  }
  .code {
    flex: 1;
    overflow: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--sl-color-gray-5) transparent;
    overscroll-behavior-x: contain;
  }
  .code {
    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        #000 var(--fade-top, 0px),
        #000 calc(100% - var(--fade-bottom, 0px)),
        transparent
      ),
      linear-gradient(
        to right,
        #000 calc(100% - var(--fade-right, 0px)),
        transparent
      );
    mask-composite: intersect;
  }
  .scroll .code {
    scroll-behavior: smooth;
  }
  .code :global([data-celestia-code-container]) {
    overflow: visible;
    border: 0;
    border-radius: 0;
  }
  .code :global(celestia-code-copy-button) {
    display: none;
  }
  .code :global(pre) {
    margin: 0;
    padding: 1.1rem 0;
    overflow: visible !important;
    background: transparent !important;
    font-size: 0.8125rem;
    line-height: 1.7;
    tab-size: 2;
  }
  .code :global(code) {
    display: block;
    min-width: max-content;
    counter-reset: line;
  }
  .code :global(.line) {
    display: inline-block;
    min-width: 100%;
    padding-right: 3rem;
    transition:
      background-color 0.45s var(--landing-ease),
      box-shadow 0.45s var(--landing-ease);
  }
  .code :global(.line)::before {
    counter-increment: line;
    content: counter(line);
    display: inline-block;
    width: 2.25rem;
    margin-right: 1.1rem;
    padding-right: 0.2rem;
    color: var(--landing-gutter);
    text-align: right;
    font-variant-numeric: tabular-nums;
    user-select: none;
    transition: color 0.45s var(--landing-ease);
  }
  .panel[data-lang="md"] .code :global(.line)::before {
    content: none;
  }
  .panel[data-lang="md"] .code :global(.line) {
    width: 100%;
    min-width: 0;
    padding-inline: 1.25rem;
    white-space: pre-wrap;
  }
  .panel[data-lang="md"] .code :global(code) {
    min-width: 0;
  }
  .code :global(.line[data-active]) {
    background: color-mix(in oklch, var(--sl-color-accent) 10%, transparent);
    box-shadow: inset 2px 0 0 var(--sl-color-accent);
  }
  .code :global(.line[data-active])::before {
    color: var(--sl-color-white);
  }
  .note {
    margin: 0;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--landing-line);
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .note.command {
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-system-mono);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
  }
  .note.command span {
    color: var(--sl-color-gray-3);
  }
  .status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  [role="tab"]:focus-visible,
  .copy:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll .code {
      scroll-behavior: auto;
    }
    .code :global(.line),
    .code :global(.line)::before {
      transition: none;
    }
  }
</style>
