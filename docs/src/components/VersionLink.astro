---
import manifest from "../../../package.json";
import { docsHref, isFrench } from "./docs-route.ts";

const route = Astro.locals.starlightRoute;
const version = `v${manifest.version}`;
const label = isFrench(route)
  ? `${version}, historique des versions`
  : `${version}, changelog`;
---

<a class="version" href={docsHref(route, "project/changelog/")} aria-label={label} title={label}>
  {version}
</a>

<style>
  .version {
    display: flex;
    flex: none;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 0 0.9rem;
    border-right: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-system-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .version:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .version:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  @media (max-width: 49.99rem) {
    .version {
      padding: 0 0.5rem;
      border-right: 0;
      font-size: 0.75rem;
    }
  }
</style>
