---
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import LanguageSwitch from "./LanguageSwitch.astro";
import SourceLinks from "./SourceLinks.astro";
---

<div class="nav-footer">
  <SourceLinks class="nav-source" />
  <div class="nav-settings"><LanguageSwitch /><ThemeSelect /></div>
</div>

<style>
  .nav-footer {
    display: none;
    margin: 2rem -1rem -3rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  .nav-footer > * {
    height: 3rem;
  }
  .nav-settings {
    display: none;
    align-items: stretch;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  .nav-settings :global(.language) {
    border-right: 1px solid var(--sl-color-hairline-light);
  }
  .nav-settings :global(starlight-theme-select) {
    display: flex;
    align-items: stretch;
  }
  @media (max-width: 63.99rem) {
    .nav-footer {
      display: block;
    }
  }
  @media (max-width: 49.99rem) {
    .nav-settings {
      display: flex;
    }
  }
</style>
