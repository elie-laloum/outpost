---
const { toc } = Astro.locals.starlightRoute;
---

<div class:list={["docs-columns", { "has-rail": Boolean(toc) }]}>
  <div class="docs-pane"><slot /></div>
  {
    toc && (
      <aside class="docs-rail print:hidden" aria-label={Astro.locals.t("tableOfContents.onThisPage")}>
        <slot name="right-sidebar" />
      </aside>
    )
  }
</div>

<style>
  .docs-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 84rem) minmax(0, 1fr);
    min-height: calc(100vh - 4rem);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 7px,
      color-mix(in oklch, var(--sl-color-gray-5) 45%, transparent) 7px 8px
    );
  }
  /* Edges are drawn outside the sheet so they merge with the sidebar and window edges. */
  .docs-pane {
    container-type: inline-size;
    grid-column: 2;
    min-width: 0;
    background: var(--sl-color-black);
    box-shadow:
      -1px 0 0 var(--docs-line),
      1px 0 0 var(--docs-line);
  }
  .docs-rail {
    display: none;
  }
  @media (min-width: 100rem) {
    .has-rail {
      grid-template-columns: minmax(0, 1fr) minmax(0, 84rem) 16rem minmax(0, 1fr);
    }
    .has-rail .docs-pane {
      border-right: 1px solid var(--docs-line);
      box-shadow: -1px 0 0 var(--docs-line);
    }
    .docs-rail {
      display: block;
      grid-column: 3;
      background: var(--sl-color-black);
      box-shadow: 1px 0 0 var(--docs-line);
    }
    .docs-rail :global(.right-sidebar-panel) {
      position: sticky;
      top: 4rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding: 2.5rem 1.5rem;
      scrollbar-width: thin;
    }
  }
  @media (max-width: 49.99rem) {
    .docs-columns {
      grid-template-columns: minmax(0, 1fr);
    }
    .docs-pane {
      grid-column: 1;
      box-shadow: none;
    }
  }
</style>
