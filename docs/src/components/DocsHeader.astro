---
import Search from "virtual:starlight/components/Search";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";
import MobileMenuToggle from "starlight-theme-celestia/components/MobileMenuToggle.astro";
import Brand from "./Brand.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import SourceLinks from "./SourceLinks.astro";
import { docsHref, docsSpace, isFrench, spaceLinks } from "./docs-route.ts";

const route = Astro.locals.starlightRoute;
const space = docsSpace(route);
---

<div class="docs-header">
  <div class="cell brand-cell"><Brand href={docsHref(route, "")} class="docs-brand" /></div>
  <nav
    class="cell spaces"
    aria-label={isFrench(route) ? "Espaces de la documentation" : "Documentation spaces"}
  >
    {
      spaceLinks(route).map((link) => (
        <a href={link.href} aria-current={link.space === space ? "true" : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="cell docs-search"><Search /></div>
  <div class="cell source"><SourceLinks /></div>
  <div class="cell settings"><LanguageSwitch /><ThemeSelect /></div>
  <div class="docs-menu"><MobileMenuToggle /></div>
</div>

<style>
  .docs-header {
    display: flex;
    height: 100%;
  }
  .cell {
    display: flex;
    align-items: center;
    min-width: 0;
    border-right: 1px solid var(--sl-color-hairline-light);
  }
  .brand-cell {
    flex: 0 0 17rem;
    align-items: stretch;
  }
  .brand-cell :global(.docs-brand) {
    flex: 1;
    align-items: center;
    padding: 0 1.5rem;
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .brand-cell :global(.docs-brand:hover) {
    background: var(--sl-color-gray-6);
  }
  .spaces {
    flex: 0 0 16rem;
    align-items: stretch;
    font-size: 0.875rem;
  }
  .spaces a {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    padding: 0 0.5rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .spaces a:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .spaces a[aria-current] {
    color: var(--sl-color-white);
    font-weight: 500;
    box-shadow: inset 0 -2px 0 var(--sl-color-white);
  }
  .docs-search {
    flex: 1 1 auto;
    align-items: stretch;
  }
  .docs-search :global(site-search) {
    display: flex;
    width: 100%;
  }
  .docs-search :global(button[data-open-modal]) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    max-width: none;
    height: 100%;
    padding: 0 1rem 0 1.25rem;
    border: 0;
    border-radius: 0;
    background: color-mix(in oklch, var(--sl-color-gray-6) 45%, var(--sl-color-black));
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    transition:
      background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .docs-search :global(button[data-open-modal]:hover) {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .docs-search :global(button[data-open-modal]:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .docs-search :global(button[data-open-modal] > kbd) {
    margin-left: auto;
    gap: 0.2rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .docs-search :global(button[data-open-modal] kbd kbd) {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0;
    background: var(--sl-color-black);
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-system-mono);
    font-size: 0.75rem;
  }
  .source {
    flex: 0 0 auto;
  }
  .settings {
    flex: 0 0 auto;
    align-items: stretch;
    border-right: 0;
  }
  .settings :global(starlight-theme-select) {
    display: flex;
    align-items: stretch;
  }
  .docs-header :global(.theme-toggle),
  :global(.nav-footer .theme-toggle) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 100%;
    border-radius: 0;
    transition: background-color 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .docs-header :global(.theme-toggle:hover),
  :global(.nav-footer .theme-toggle:hover) {
    background: var(--sl-color-gray-6);
  }
  .docs-header :global(.theme-toggle:focus-visible),
  :global(.nav-footer .theme-toggle:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
  .docs-header :global(.theme-toggle),
  .docs-header :global(.theme-toggle svg),
  .docs-header :global(.theme-toggle path),
  :global(.nav-footer .theme-toggle),
  :global(.nav-footer .theme-toggle svg),
  :global(.nav-footer .theme-toggle path) {
    color: var(--sl-color-gray-3);
    fill: currentColor;
  }
  .docs-header :global(.theme-toggle:hover),
  .docs-header :global(.theme-toggle:hover svg),
  .docs-header :global(.theme-toggle:hover path) {
    color: var(--sl-color-white);
  }
  .docs-menu {
    display: none;
  }
  @media (max-width: 79.99rem) {
    .source :global(.version) {
      display: none;
    }
  }
  @media (max-width: 63.99rem) {
    .source {
      display: none;
    }
  }
  @media (max-width: 49.99rem) {
    .cell {
      border-right: 0;
    }
    .brand-cell {
      flex: 0 0 auto;
      padding: 0 0.75rem 0 1rem;
    }
    .spaces {
      flex: 0 0 auto;
      font-size: 0.8rem;
    }
    .spaces a {
      padding: 0 0.4rem;
    }
    .docs-search {
      flex: 0 0 auto;
      margin-left: auto;
    }
    .docs-search :global(site-search) {
      width: auto;
    }
    .docs-search :global(button[data-open-modal]) {
      width: 2.75rem;
      padding: 0;
      justify-content: center;
      background: none;
    }
    .settings {
      display: none;
    }
    .docs-menu {
      display: flex;
      align-items: center;
      padding-right: 1rem;
    }
    .docs-header :global(.docs-brand .name) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
  }
</style>
