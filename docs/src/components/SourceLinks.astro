---
import { Icon } from "@astrojs/starlight/components";
import { isFrench } from "./docs-route.ts";

interface Props {
  class?: string;
}

const route = Astro.locals.starlightRoute;
const french = isFrench(route);
const sources = [
  ["GitLab", "https://gitlab.elielaloum.com/elielaloum/outpost", "gitlab"],
  [french ? "Miroir GitHub" : "GitHub mirror", "https://github.com/elie-laloum/outpost", "github"],
  ["npm", "https://www.npmjs.com/package/@elie-laloum/outpost", "npm"],
] as const;
---

<div class:list={["source-links", Astro.props.class]}>
  {
    sources.map(([label, href, icon]) => (
      <a class="source" href={href} aria-label={label} title={label}>
        <Icon name={icon} size="1.125rem" />
      </a>
    ))
  }
</div>

<style>
  .source-links {
    display: flex;
    align-items: stretch;
    height: 100%;
  }
  a {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .source {
    height: 100%;
    aspect-ratio: 1;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: -2px;
  }
</style>
