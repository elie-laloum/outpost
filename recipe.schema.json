{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Outpost recipe",
  "description": "Local sequential command and agent recipes. Version 2 adds typed inputs and explicit {{ inputs.name }} / {{ steps.key.field }} references. Graph and binding checks also require outpost recipe validate.",
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable"],
      "properties": {
        "executable": {
          "type": "string",
          "pattern": "\\S"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stdin": {
          "type": "string"
        },
        "directory": {
          "type": "string",
          "pattern": "\\S"
        },
        "variables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "after": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "agent": {
          "type": "string",
          "pattern": "\\S"
        },
        "brief": {
          "type": "string",
          "pattern": "\\S"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempts"],
          "properties": {
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["command"],
          "not": {
            "anyOf": [
              {
                "required": ["agent"]
              },
              {
                "required": ["brief"]
              }
            ]
          }
        },
        {
          "required": ["agent", "brief"],
          "not": {
            "required": ["command"]
          }
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": {
          "enum": ["string", "number", "boolean"]
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "default": {
          "type": ["string", "number", "boolean"]
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": ["string", "number", "boolean"]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "string"
              },
              "enum": {
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "number"
              },
              "enum": {
                "items": {
                  "type": "number"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              },
              "enum": {
                "items": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "tasks"],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "tasks"],
      "properties": {
        "version": {
          "const": 2
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "recipeVersion": {
          "type": "string",
          "pattern": "\\S"
        },
        "$schema": {
          "type": "string",
          "pattern": "\\S"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "name", "tasks"],
      "properties": {
        "version": {
          "const": 3
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/task"
          }
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "recipeVersion": {
          "type": "string",
          "pattern": "\\S"
        },
        "$schema": {
          "type": "string",
          "pattern": "\\S"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          }
        }
      }
    }
  ]
}
