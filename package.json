{
  "name": "@elie-laloum/outpost",
  "version": "4.0.0",
  "description": "Programmable sandboxes, coding agents and typed workflows.",
  "type": "module",
  "license": "MIT",
  "author": "Elie Laloum",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "outpost": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/docker": {
      "types": "./dist/providers/docker.d.ts",
      "import": "./dist/providers/docker.js"
    },
    "./providers/podman": {
      "types": "./dist/providers/podman.d.ts",
      "import": "./dist/providers/podman.js"
    },
    "./providers/local": {
      "types": "./dist/providers/local.d.ts",
      "import": "./dist/providers/local.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "import": "./dist/providers/vercel.js"
    },
    "./providers/daytona": {
      "types": "./dist/providers/daytona.d.ts",
      "import": "./dist/providers/daytona.js"
    },
    "./opentelemetry": {
      "types": "./dist/infrastructure/opentelemetry.d.ts",
      "import": "./dist/infrastructure/opentelemetry.js"
    },
    "./providers/firecracker": {
      "types": "./dist/providers/firecracker.d.ts",
      "import": "./dist/providers/firecracker.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/unit/*.test.ts test/functional/*.test.ts",
    "test:unit": "node --test test/unit/*.test.ts",
    "test:functional": "node --test test/functional/*.test.ts",
    "coverage": "c8 --all --include=src/**/*.ts --exclude=src/cli/main.ts --exclude=src/**/*.types.ts --reporter=text --reporter=lcov --check-coverage --lines=80 --functions=80 --branches=80 npm test",
    "check": "npm run architecture && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:container": "node --test test/container.test.ts",
    "architecture": "node scripts/check-architecture.mjs",
    "docs:sync": "npm run build && node docs/scripts/sync-reference.mjs",
    "docs:check": "node docs/scripts/sync-reference.mjs --check && npm run check --prefix docs",
    "docs:dev": "npm run dev --prefix docs",
    "docs:build": "npm run build --prefix docs",
    "docs:test": "npm run test:build --prefix docs && node docs/scripts/check-examples.mjs && node --test docs/scripts/release-channel.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.elielaloum.com/elielaloum/outpost.git"
  },
  "bugs": {
    "url": "https://github.com/elie-laloum/outpost/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@daytona/sdk": "^0.216.0",
    "@vercel/sandbox": "^3.3.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@daytona/sdk": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "prettier": "^3.5.3",
    "c8": "^10.1.3",
    "@daytona/sdk": "^0.216.0",
    "@vercel/sandbox": "^3.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-metrics": "^2.0.0"
  },
  "homepage": "https://elie-laloum.github.io/outpost/"
}
