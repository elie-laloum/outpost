{
  "name": "@elie-laloum/outpost",
  "version": "11.0.1",
  "description": "Programmable sandboxes, coding agents and typed workflows.",
  "type": "module",
  "license": "MIT",
  "author": "Elie Laloum",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "outpost": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/docker": {
      "types": "./dist/providers/docker.d.ts",
      "import": "./dist/providers/docker.js"
    },
    "./providers/podman": {
      "types": "./dist/providers/podman.d.ts",
      "import": "./dist/providers/podman.js"
    },
    "./providers/local": {
      "types": "./dist/providers/local.d.ts",
      "import": "./dist/providers/local.js"
    },
    "./providers/vercel": {
      "types": "./dist/providers/vercel.d.ts",
      "import": "./dist/providers/vercel.js"
    },
    "./providers/daytona": {
      "types": "./dist/providers/daytona.d.ts",
      "import": "./dist/providers/daytona.js"
    },
    "./opentelemetry": {
      "types": "./dist/infrastructure/opentelemetry.d.ts",
      "import": "./dist/infrastructure/opentelemetry.js"
    },
    "./providers/firecracker": {
      "types": "./dist/providers/firecracker.d.ts",
      "import": "./dist/providers/firecracker.js"
    },
    "./transports/s3": {
      "types": "./dist/infrastructure/s3-transport.d.ts",
      "import": "./dist/infrastructure/s3-transport.js"
    },
    "./queues/bullmq": {
      "types": "./dist/infrastructure/task-queue-bullmq.d.ts",
      "import": "./dist/infrastructure/task-queue-bullmq.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./secrets/vault": {
      "types": "./dist/adapters/secrets/vault.d.ts",
      "import": "./dist/adapters/secrets/vault.js"
    },
    "./secrets/onepassword": {
      "types": "./dist/adapters/secrets/onepassword.d.ts",
      "import": "./dist/adapters/secrets/onepassword.js"
    },
    "./secrets/aws": {
      "types": "./dist/adapters/secrets/aws.d.ts",
      "import": "./dist/adapters/secrets/aws.js"
    },
    "./secrets/gcp": {
      "types": "./dist/adapters/secrets/gcp.d.ts",
      "import": "./dist/adapters/secrets/gcp.js"
    },
    "./secrets/azure": {
      "types": "./dist/adapters/secrets/azure.d.ts",
      "import": "./dist/adapters/secrets/azure.js"
    },
    "./secrets/infisical": {
      "types": "./dist/adapters/secrets/infisical.d.ts",
      "import": "./dist/adapters/secrets/infisical.js"
    },
    "./recipe.schema.json": "./recipe.schema.json",
    "./recipe-configuration.schema.json": "./recipe-configuration.schema.json",
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "import": "./dist/recipes.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "recipe.schema.json",
    "recipe-configuration.schema.json",
    "recipes/*.yaml",
    "recipes/catalog.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'test/unit/*.test.ts' 'test/functional/*.test.ts'",
    "test:unit": "node --test 'test/unit/*.test.ts'",
    "test:functional": "node --test 'test/functional/*.test.ts'",
    "coverage": "c8 --all --include='src/**/*.ts' --exclude=src/cli/main.ts --exclude='src/**/*.types.ts' --reporter=text --reporter=lcov --check-coverage --lines=80 --functions=80 --branches=80 bun run test",
    "check": "bun run architecture && bun run typecheck && bun run test && bun run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "bun run build",
    "test:package": "node scripts/package-smoke.mjs",
    "test:container": "node --test test/container.test.ts",
    "architecture": "node scripts/check-architecture.mjs",
    "docs:sync": "bun run build && node docs/scripts/sync-reference.mjs",
    "docs:check": "node docs/scripts/sync-reference.mjs --check && bun run --cwd docs check",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run --cwd docs build",
    "docs:test": "bun run --cwd docs test:build && node docs/scripts/check-examples.mjs && node --test docs/scripts/release-channel.test.mjs",
    "docs:test:browser": "bun run --cwd docs test:browser",
    "docs:test:container": "node docs/scripts/check-container-examples.mjs",
    "test:redis": "node --test test/redis.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.elielaloum.com/elielaloum/outpost.git"
  },
  "bugs": {
    "url": "https://github.com/elie-laloum/outpost/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@daytona/sdk": "^0.216.0",
    "@opentelemetry/api": "^1.9.0",
    "@vercel/sandbox": "^3.3.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "bullmq": "^5.81.5",
    "@aws-sdk/client-secrets-manager": "^3.1147.0",
    "@google-cloud/secret-manager": "^7.1.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@1password/sdk": "^0.5.0",
    "@infisical/sdk": "^5.0.2"
  },
  "peerDependenciesMeta": {
    "@daytona/sdk": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "@aws-sdk/client-secrets-manager": {
      "optional": true
    },
    "@google-cloud/secret-manager": {
      "optional": true
    },
    "@azure/keyvault-secrets": {
      "optional": true
    },
    "@1password/sdk": {
      "optional": true
    },
    "@infisical/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1password/sdk": "^0.5.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-secrets-manager": "^3.1147.0",
    "@azure/identity": "^4.13.3",
    "@azure/keyvault-secrets": "^4.11.2",
    "@daytona/sdk": "^0.216.0",
    "@google-cloud/secret-manager": "^7.1.1",
    "@infisical/sdk": "^5.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vercel/sandbox": "^3.3.0",
    "bullmq": "^5.81.5",
    "c8": "^10.1.3",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3"
  },
  "homepage": "https://elie-laloum.github.io/outpost/",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "ajv": "8.20.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "shell-quote": "1.11.0"
  }
}
